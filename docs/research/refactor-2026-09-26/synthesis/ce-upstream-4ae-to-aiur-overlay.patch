+def fetch_host_branch_update_capability(pr, owner, name, host=None):
+    """Read GitHub's operation-specific update-branch capability without mutating.
+
+    This fact intentionally says nothing about direct Git push authority, which DIRTY repair must
+    prove separately. Probe and response-shape uncertainty fail closed as `unknown`.
+    """
+    query = """
+query($owner:String!,$repo:String!,$pr:Int!){
+  repository(owner:$owner,name:$repo){
+    pullRequest(number:$pr){ viewerCanUpdateBranch }
+  }
+}"""
+    r = _run(["gh", "api", "graphql", *_host_args(host), "-f", f"owner={owner}",
+              "-f", f"repo={name}", "-F", f"pr={pr}", "-f", f"query={query}"])
+    if r.returncode != 0:
+        return "unknown"
+    try:
+        capability = json.loads(r.stdout)["data"]["repository"]["pullRequest"][
+            "viewerCanUpdateBranch"]
+    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
+        return "unknown"
+    return capability if isinstance(capability, bool) else "unknown"
