  "findings": [
    {
      "id": "nonelixir-web-01",
      "category": "test-coverage",
      "severity": "P2",
      "title": "Reduced-motion assertion cannot detect a broken production freeze offset",
      "locations": [
        {
          "path": "website/scripts/assert-sim.ts",
          "lines": "16-18,114-120"
        },
        {
          "path": "website/src/dashboard.ts",
          "lines": "598-604"
        }
      ],
      "description": "Check 6 validates the local literal 22 against BEAT instead of exercising startDashboard. Changing only the production freeze offset from 22 seconds to zero removes the posted user text from the reduced-motion frame, while every assertion in assert-sim still passes and prints the same output. This is a confirmed coverage hole, not evidence that the frozen baseline currently renders the wrong frame.",
      "evidence": "website-review-probe.json: both suite exits are zero; baseline generated HTML has the posted user message, the freeze-at-zero mutation does not. The browser brand tests do not exercise reduced-motion rendering.",
      "recommendation": "Exercise startDashboard with reduced-motion enabled and assert the posted user message and agent reply in its rendered output. Exporting a shared offset can remove the duplicate literal but does not alone verify rendering.",
      "refactor_hint": "Keep the marketing simulation independent of the live runtime. Its own renderer should own timing; its tests should observe output rather than restate timing constants.",
      "effort": "S",
      "verification": {
        "status": "reproduced_with_isolated_source_probe",
        "evidence_file": "website-review-probe.json",
        "limits": "No live browser or Aiur run; minimal DOM/API doubles and fake clock. No independent skeptic review yet."
      }
    },
    {
      "id": "nonelixir-web-02",
      "category": "error-handling",
      "severity": "P2",
      "title": "Capture readiness deadline does not bound an in-flight HTTP request",
      "locations": [
        {
          "path": "website/scripts/capture-dashboard.mjs",
          "lines": "170-198"
        }
      ],
      "description": "The 30-second deadline is checked only before fetch. Neither fetch nor response.text receives a cancellation signal, so a stalled response prevents reaching the deadline check and the finally cleanup until that operation settles or its underlying transport fails. A successful response arriving after the deadline is accepted. The application-level deadline therefore does not enforce its advertised bound.",
      "evidence": "An extracted, unmodified waitUntilReady with a fake clock remains pending at 31 seconds while fetch is unresolved; the fetch options contain no signal. Resolving the response with the fixture markers after that deadline returns success. This is a source-level controlled probe, not a measured production hang.",
      "recommendation": "Apply an abort signal using the remaining deadline to the request and body read, and recheck the deadline before accepting readiness. Cover a connected response that never finishes, not only connection refusal.",
      "refactor_hint": "Screenshot tooling owns fixture readiness and teardown. Keep those lifecycle obligations in its small harness instead of adding them to the production daemon.",
      "effort": "S",
      "verification": {
        "status": "reproduced_with_isolated_source_probe",
        "evidence_file": "website-review-probe.json",
        "limits": "No live browser or Aiur run; minimal DOM/API doubles and fake clock. No independent skeptic review yet."
      }
    },
    {
      "id": "nonelixir-web-03",
      "category": "error-handling",
      "severity": "P2",
      "title": "Copy control advances before confirming clipboard success",
      "locations": [
        {
          "path": "website/src/main.ts",
          "lines": "81-116"
        },
        {
          "path": "website/src/styles.css",
          "lines": "372"
        }
      ],
      "description": "The click handler discards copyText's promise, applies the copied class immediately, and expands shell next steps. When the modern clipboard rejects and execCommand returns false, copyText nevertheless resolves. The user can be directed to continue with an unchanged clipboard. The frozen CSS makes copied an accent state; this finding does not claim the button displays a literal success message.",
      "evidence": "The extracted copyText function resolves with a rejected writeText and a false execCommand result; the fallback is called once. The actual click handler uses void copyText(command) before the copied class and show-next updates.",
      "recommendation": "Return an explicit copy outcome, check execCommand's boolean, await completion in the click handler, and apply completion feedback only after success. Offer selectable command text on failure.",
      "refactor_hint": "A local browser interaction fix; this does not justify a shared daemon clipboard service or a new package.",
      "effort": "S",
      "verification": {
        "status": "reproduced_with_isolated_source_probe",
        "evidence_file": "website-review-probe.json",
        "limits": "No live browser or Aiur run; minimal DOM/API doubles and fake clock. No independent skeptic review yet."
      }
    }
  ],
