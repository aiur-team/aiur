{
  "version": 1,
  "commands": [
    {"argv": ["status"], "expression": "Aiur.AgentControlCLI.status()"},
    {"argv": ["usage"], "expression": "Aiur.Usage.CLI.rpc(nil, false)"},
    {"argv": ["agents"], "expression": "Aiur.AgentControlCLI.agents()"},
    {"argv": ["accounts"], "expression": "Aiur.Usage.CLI.rpc(nil, false)"},
    {"argv": ["commands"], "expression": "Aiur.AgentControlCLI.commands([filter: :all])"},
    {"argv": ["units"], "expression": "Aiur.AgentControlCLI.units([scope: Base.decode64!(\"bGl2ZQ==\")])"},
    {"argv": ["queue", "show"], "expression": "Aiur.AgentControlCLI.queue([])"},
    {"argv": ["queue", "order"], "expression": "Aiur.AgentControlCLI.queue([verb: :order, caller_agent_workspace: Base.decode64!(\"\")])"},
    {"argv": ["epic", "list"], "expression": "Aiur.AgentControlCLI.epic([action: :list])"},
    {"argv": ["epic", "show"], "expression": "Aiur.AgentControlCLI.epic([action: :show])"},
    {"argv": ["feature", "show"], "expression": "Aiur.AgentControlCLI.feature([op: :show])"},
    {"argv": ["build-orders"], "expression": "Aiur.AgentControlCLI.build_orders([])"},
    {"argv": ["analytics"], "expression": "Aiur.AgentControlCLI.analytics([range: :run])"},
    {"argv": ["github-cost"], "expression": "Aiur.Usage.CLI.rpc(Base.decode64!(\"Z2l0aHVi\"), false)"},
    {"argv": ["experiments", "list"], "expression": "Aiur.AgentControlCLI.experiments([verb: :list, argv: []])"},
    {"argv": ["experiments", "show"], "expression": "Aiur.AgentControlCLI.experiments([verb: :show, argv: []])"},
    {"argv": ["experiments", "metrics"], "expression": "Aiur.AgentControlCLI.experiments([verb: :metrics, argv: []])"},
    {"argv": ["experiments", "events"], "expression": "Aiur.AgentControlCLI.experiments([verb: :events, argv: []])"},
    {"argv": ["experiments", "stats"], "expression": "Aiur.AgentControlCLI.experiments([verb: :stats, argv: []])"},
    {"argv": ["experiments", "analyze"], "expression": "Aiur.AgentControlCLI.experiments([verb: :analyze, argv: []])"},
    {"argv": ["capabilities"], "expression": "Aiur.AgentControlCLI.capabilities([])"},
    {"argv": ["ticket-usage", "1"], "expression": "Aiur.Usage.CLI.rpc(Base.decode64!(\"dGlja2V0\"), false)"},
    {"argv": ["github-usage"], "expression": "Aiur.Usage.CLI.rpc(Base.decode64!(\"Z2l0aHVi\"), false)"},
    {"argv": ["alerts"], "expression": "Aiur.AgentControlCLI.alerts(argv: [])"},
    {"argv": ["executor-sweep"], "expression": "Aiur.AgentControlCLI.executor_sweep([])"},
    {"argv": ["watch", "--full"], "expression": "Aiur.AgentControlCLI.watch(mode: :full)"},
    {"argv": ["executor-subscriptions"], "expression": "Aiur.AgentControlCLI.executor_subscriptions()"},
    {"argv": ["executor-roster"], "expression": "Aiur.AgentControlCLI.executor_roster(json: false)"},
    {"argv": ["executor-session"], "expression": "Aiur.HarnessSessionCLI.rpc(json: false)"},
    {"argv": ["message", "--status", "1"], "expression": "Aiur.AgentControlCLI.message_status(1)"}
  ]
}
