# aiur workspace hooks — referenced from .aiur/config via `hooks_file: hooks`.
timeout_ms: 600000
after_create: |
  set -e
  base_branch="${THIS_BASE_BRANCH:-main}"
  git clone "$THIS_REPOSITORY_URL" .
  git fetch origin "$base_branch"
  if git show-ref --verify --quiet "refs/remotes/origin/$AIUR_TICKET_BRANCH"; then
    git checkout -B "$AIUR_TICKET_BRANCH" "origin/$AIUR_TICKET_BRANCH"
  else
    git checkout -B "$AIUR_TICKET_BRANCH" "origin/$base_branch"
  fi
  mkdir -p ./.aiur-hex ./.aiur-mix
  if [ -f mise.toml ]; then
    mise trust mise.toml >/dev/null 2>&1 || true
    mise install >/dev/null 2>&1 || true
  fi
  # Warm Hex + dep compile caches so the agent's first `mix` call
  # doesn't waste 30-60s on cold deps.get + first-time-compile.
  # Failures are non-fatal: if the workspace can't fetch deps now
  # (network blip, dep change), the agent's first `mix deps.get`
  # will pick it up.
  if [ -f src/mix.exs ]; then
    # Output flows back to Workspace.run_hook via System.cmd
    # (stderr_to_stdout: true). Don't redirect to /dev/null — that
    # masks silent failures where mix exits cleanly but didn't
    # actually fetch deps (e.g. mise exec failing, hex install
    # erroring). The Elixir side logs a tail of the output on
    # success and the full output on non-zero exit. `|| true` is
    # retained so the hook is non-fatal for the agent boot path:
    # if deps prefetch fails, the agent picks it up on first
    # `mix` call, just slower.
    HEX_HOME="$PWD/.aiur-hex" MIX_HOME="$PWD/.aiur-mix" \
      MISE_TRUSTED_CONFIG_PATHS="$PWD/mise.toml" \
      bash -c 'cd src && mise exec -- mix local.hex --force --if-missing && mise exec -- mix local.rebar --force --if-missing && mise exec -- mix deps.get && mise exec -- mix compile' \
      2>&1 | tail -200 || true
  fi
before_run: |
  set -e
  base_branch="${THIS_BASE_BRANCH:-main}"
  workspace_root="$(pwd -P)"
  git_toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$git_toplevel" ]; then
    git_toplevel="$(CDPATH= cd "$git_toplevel" && pwd -P)"
  fi
  if [ -z "$git_toplevel" ] || [ "$git_toplevel" != "$workspace_root" ]; then
    logs_backup=""
    restore_logs() {
      if [ -n "$logs_backup" ] && [ -d "$logs_backup" ]; then
        mkdir -p logs
        cp -a "$logs_backup"/. logs/
        rm -rf "$logs_backup"
        logs_backup=""
      fi
    }
    trap restore_logs 0
    if [ -d logs ]; then
      logs_backup="$(mktemp -d "${TMPDIR:-/tmp}/aiur-workspace-logs.XXXXXX")"
      cp -a logs/. "$logs_backup"/
    fi
    find . -mindepth 1 -maxdepth 1 -exec rm -rf {} +
    git clone "$THIS_REPOSITORY_URL" .
    git fetch origin "$base_branch"
    if git show-ref --verify --quiet "refs/remotes/origin/$AIUR_TICKET_BRANCH"; then
      git checkout -B "$AIUR_TICKET_BRANCH" "origin/$AIUR_TICKET_BRANCH"
    else
      git checkout -B "$AIUR_TICKET_BRANCH" "origin/$base_branch"
    fi
    restore_logs
    trap - 0
  else
    git fetch origin
    if ! git diff --quiet -- . ':(exclude).aiur-hex/**' ':(exclude).aiur-mix/**' ':(exclude)logs' ||
       ! git diff --cached --quiet -- . ':(exclude).aiur-hex/**' ':(exclude).aiur-mix/**' ':(exclude)logs'; then
      # Tracked changes are present. Signal the refusal with exit 65.
      # The Elixir side keys on that status code: a fresh todo dispatch
      # recreates the stale leftover clean; a live/resumed agent's uncommitted
      # WIP is left untouched and the configured-base refresh is skipped
      # non-fatally so the agent keeps working (#653). The text below is
      # Executor-facing only. Do NOT treat this as a hard failure.
      echo "Refusing to refresh workspace from origin/$base_branch because tracked source changes are present." >&2
      echo "Leaving uncommitted work in place; skipping the origin/$base_branch refresh for this run." >&2
      exit 65
    fi
    # Ticket branches created before package caches became runtime-only can
    # still track these files. Preserve the complete warm caches outside the
    # worktree while their tracked paths are reset and the base deletion is
    # merged, then restore them as ignored runtime state. The exit trap also
    # restores them if checkout or merge fails.
    cache_backup="$(mktemp -d "/tmp/aiur-workspace-caches.XXXXXX")"
    restore_caches() {
      if [ -n "$cache_backup" ] && [ -d "$cache_backup" ]; then
        rm -rf ./.aiur-hex ./.aiur-mix
        for cache_dir in .aiur-hex .aiur-mix; do
          if [ -e "$cache_backup/$cache_dir" ]; then
            cp -a "$cache_backup/$cache_dir" ./
          fi
        done
        rm -rf "$cache_backup"
        cache_backup=""
      fi
    }
    for cache_dir in .aiur-hex .aiur-mix; do
      if [ -e "$cache_dir" ]; then
        cp -a "$cache_dir" "$cache_backup"/
      fi
    done
    trap restore_caches 0
    if ! git diff --quiet HEAD -- .aiur-hex .aiur-mix; then
      git diff --name-only -z HEAD -- .aiur-hex .aiur-mix |
        git restore --source=HEAD --staged --worktree --pathspec-from-file=- --pathspec-file-nul
    fi
    current_branch="$(git branch --show-current)"
    if [ "$current_branch" != "$AIUR_TICKET_BRANCH" ]; then
      if git show-ref --verify --quiet "refs/heads/$AIUR_TICKET_BRANCH"; then
        git checkout "$AIUR_TICKET_BRANCH"
      elif git show-ref --verify --quiet "refs/remotes/origin/$AIUR_TICKET_BRANCH"; then
        git checkout -B "$AIUR_TICKET_BRANCH" "origin/$AIUR_TICKET_BRANCH"
      else
        git checkout -B "$AIUR_TICKET_BRANCH" "origin/$base_branch"
      fi
    fi
    git merge --no-edit "origin/$base_branch"
    restore_caches
    trap - 0
  fi
  mkdir -p ./.aiur-hex ./.aiur-mix
  if [ -f mise.toml ]; then
    mise trust mise.toml >/dev/null 2>&1 || true
    mise install >/dev/null 2>&1 || true
  fi
  # Idempotent deps + compile warm-up on every dispatch. Free when the
  # cache is warm (mix deps.get + mix compile no-op in seconds); pays
  # off when the workspace is a fresh clone, an aiur --debug resume
  # against an existing dir, or after a deps lockfile bump.
  if [ -f src/mix.exs ]; then
    # Output flows back to Workspace.run_hook via System.cmd
    # (stderr_to_stdout: true). Don't redirect to /dev/null — that
    # masks silent failures where mix exits cleanly but didn't
    # actually fetch deps (e.g. mise exec failing, hex install
    # erroring). The Elixir side logs a tail of the output on
    # success and the full output on non-zero exit. `|| true` is
    # retained so the hook is non-fatal for the agent boot path:
    # if deps prefetch fails, the agent picks it up on first
    # `mix` call, just slower.
    HEX_HOME="$PWD/.aiur-hex" MIX_HOME="$PWD/.aiur-mix" \
      MISE_TRUSTED_CONFIG_PATHS="$PWD/mise.toml" \
      bash -c 'cd src && mise exec -- mix local.hex --force --if-missing && mise exec -- mix local.rebar --force --if-missing && mise exec -- mix deps.get && mise exec -- mix compile' \
      2>&1 | tail -200 || true
  fi
before_remove: |
  git status --short
