    message: Sent back for changes

  # ---------- Ticket lifecycle (GitHub-authoritative) ---------------------
  "ticket.*.pr.merged":
    message: Merge complete
    sound:
      - "~/alerts/archon/archon-merging-complete.wav"
  "ticket.*.pr.draft_approved_green":
    message: Approved green PR left as a draft
    sound:
      - "~/alerts/advisor/advisor-not-enough-minerals.wav"
      - "~/alerts/advisor/advisor-additional-pylons.wav"
  "ticket.*.issue.state.changed":
    message: Task state changed
    sound:
      - "~/alerts/advisor-upgrade-complete.wav"

  # ---------- Orchestrator dispatch ---------------------------------------
  "system.dispatch.todo_capacity_exceeded":
    message: Todo queue exceeds capacity
    sound:
      - "~/alerts/advisor/advisor-additional-pylons.wav"
  "system.dispatch.prewarm_blocked":
