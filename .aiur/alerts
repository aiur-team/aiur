    sound:
      - "~/alerts/advisor/advisor-your-will.wav"
      - "~/alerts/advisor/advisor-i-hear-you.wav"
      - "~/alerts/advisor/advisor-of-course.wav"
      - "~/alerts/advisor/advisor-for-adun.wav"
      - "~/alerts/advisor/advisor-terra-khala.wav"
      - "~/alerts/templar/templar-yes-executor.wav"
      - "~/alerts/templar/templar-consider-it-done.wav"
      - "~/alerts/templar/templar-indeed.wav"
      - "~/alerts/templar/templar-i-concur.wav"
