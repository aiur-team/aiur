  "system.dispatch.prewarm_blocked.resolved":
    message: Shared prewarm released dispatch
  "system.dispatch.capacity_starved":
    message: Fleet dispatch capacity is constrained
    sound:
      - "~/alerts/advisor/advisor-additional-pylons.wav"
  "system.dispatch.capacity_starved.resolved":
    message: Fleet dispatch capacity recovered
  "system.fleet.capacity.starved":
    message: Fleet capacity is under-utilised
    sound:
      - "~/alerts/advisor/advisor-additional-pylons.wav"
  "system.fleet.capacity.starved.resolved":
