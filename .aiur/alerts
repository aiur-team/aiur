      - "~/alerts/zealot/zealot-geehous.wav"
      - "~/alerts/zealot/zealot-gaugurah.wav"
      - "~/alerts/zealot/zealot-blasuserm.wav"
      - "~/alerts/zealot/zealot-honor-guide-me.wav"
      - "~/alerts/zealot/zealot-for-adun.wav"
  "ticket.*.issue.label.added.agent.in-progress":
    message: Task picked up
  "ticket.*.issue.label.added.agent.human-review":
    message: Ready for human review
    sound:
      - "~/alerts/advisor/advisor-under-attack.wav"
      - "~/alerts/advisor/advisor-warriors-engaged-enemy.wav"
      - "~/alerts/zealot/zealot-attack.wav"
