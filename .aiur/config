tracker:
  kind: github
  base_branch: v2
  active_states:
    - todo
    - in-progress
    - rework
    - merging
  terminal_states:
    - done
    - cancelled
    - canceled
  github:
    repo: its-everdred/aiur
    label_prefix: agent
polling:
  interval_seconds: 5
max_vertical_panes: 3
pre_warmed_sessions: 3
# Cap (MB) on total ~/.aiur/logs size; oldest sessions swept every 5 min once exceeded. See Aiur.Logs.Retention.
max_log_history_mb: 1000
server:
  host: 100.81.109.51
  port: 4000
workspace:
  root: ~/code/aiur-workspaces
hooks_file: hooks
agent:
  kind: codex
  max_concurrent_agents: 5
  # CPU load gate (#465): hold new dispatch while 1-min load > value * schedulers
  # (~12). 1.5 → holds once load passes ~18. Raise/lower while ramping.
  max_load_average: 1.5
  max_turns: 12
  # complexity:N label routes to a backend (model:<backend> label overrides); unlisted/unlabeled fall back to kind; 4–5 use claude for stronger reasoning.
  routing:
    4: claude
    5: claude
  claude:
    command: aiur-claude
    # model omitted → claude CLI's own default; set e.g. `model: claude-sonnet-4-6` to pin (sent as `claude --model <value>`).
  codex:
    command: codex --config shell_environment_policy.inherit=all --config 'model="gpt-5.5"' --config model_reasoning_effort=high app-server
    approval_policy: never
    thread_sandbox: workspace-write
    turn_sandbox_policy:
      type: workspaceWrite
      writableRoots:
        - /home/applekid/code/aiur-workspaces
        - /home/orangekid/code/aiur-workspaces
        - /tmp
      networkAccess: true
opencode:
  command: opencode
  bridge_host: 127.0.0.1
  serve_args: []
  model_prefix: aiur
prompt_file: prompt.md
# Warm base pre-warm (dogfood): build one shared base of the target branch once, then
# materialize each agent workspace from it (copy-on-write) instead of cold-cloning.
# The build command lives in a sibling `.aiur/prewarm` script (path relative to
# this config), keeping the multi-line shell out of the main config.
prewarm:
  enabled: true
  base_build_file: prewarm
  poll_seconds: 0
