tracker:
  kind: github
  base_branch: main
  active_states:
    - todo
    - in-progress
    - rework
    - merging
  terminal_states:
    - done
    - closed
    - cancelled
    - canceled
  github:
    repo: aiur-team/aiur
    label_prefix: agent
    bot_account: its-applekid
    human_mergers:
      - its-everdred
    # Finite Build Order planning-graph safeguards. Defaults accept exactly 100 roots/members.
    planning_root_limit: 100
    planning_page_budget: 4
    planning_call_budget: 4
polling:
  interval_seconds: 5
max_vertical_panes: 3
pre_warmed_sessions: 3
# Cap (MB) on total ~/.aiur/logs size; oldest sessions swept every 5 min once exceeded. See Aiur.Logs.Retention.
max_log_history_mb: 1000
server:
  host: 0.0.0.0
  port: 4000
workspace:
  root: ~/code/aiur-workspaces
hooks_file: hooks
agent:
  # Ordered dispatch preference: presence enables a backend, the first available
  # entry is the default, and aiur falls back to the next one when a token or
  # usage limit hits. DeepSeek first for the remaining Build Order #1567 work.
  priority: [deepseek, codex, claude]
  max_concurrent_agents: 16
  # Bound every agent-launched Mix VM (and ExUnit's default max_cases) to four schedulers.
  mix_scheduler_cap: 4
  # Fleet cap for agent-launched mix compile/test verification. 0 disables it.
  max_concurrent_builds: 2
  # Offset admitted mix compile/test starts so fleet CPU ramps do not synchronize.
  build_start_stagger_seconds: 5
  # CPU load gate (#465): hold new dispatch while 1-min load > value * schedulers
  # (~12). 1.5 → holds once load passes ~18. Raise/lower while ramping.
  max_load_average: 1.5
  max_turns: 12
  # Lifetime dispatch latch (#1305, hardened by #1453). 0 disables it, which let
  # #1091 burn 85 cold dispatches on a ticket that was functionally done in 53
  # minutes (~20% of them productive). Since #1453 the counter only bills
  # dispatches that survived provisioning (preflight/prewarm/tracker-auth
  # failures leave it unchanged) and `aiurdev reset-budget <id>` is the
  # supported exit. Hitting the cap signals a structurally-stuck ticket that
  # needs an operator, not more turns. 40 (raised from the pre-#1453 20): with
  # the counter committed-only, a legitimate multi-round rework ticket plus
  # normal churn stays comfortably under it while a genuinely-stuck ticket
  # still latches. Set 0 to rely solely on the windowed thrash guard
  # (`codex.thrash_max_per_window`).
  max_dispatches_per_ticket: 40
  # Per-complexity turn ceiling; a level set here replaces `max_turns` for that
  # ticket (it is an override, not a floor). Only the trivial levels are tightened —
  # 4 and 5 are deliberately left unset so they keep falling back to `max_turns: 12`
  # rather than being raised.
  max_turns_by_complexity:
    1: 4
    2: 8
    3: 12
  # A silent turn (e.g. a long `mix test --cover` run with no intermediate agent
  # output) is killed after this. Raised from the 5-min default so flake-fix /
  # full-suite validation runs can complete. turn_timeout_ms already defaults to 60 min.
  stall_timeout_ms: 3600000
  # Complexity routing is left unset for this run: every complexity level falls
  # back to `priority`, so DeepSeek is the default backend for the remaining
  # Build Order #1567 work with codex/claude as fallback.
  # routing:
  #   1: "codex:luna:low"
  #   2: "codex:luna:medium"
  #   3: "codex:terra:high"
  #   4: "codex:terra:xhigh"
  #   5: "codex:sol:max"
  codex:
    command: codex app-server
    approval_policy: never
    thread_sandbox: workspace-write
    turn_sandbox_policy:
      type: workspaceWrite
      writableRoots:
        - /home/orangekid/code/aiur-workspaces
        - /tmp
      networkAccess: true
opencode:
  command: opencode
  bridge_host: 127.0.0.1
  serve_args: []
  model_prefix: aiur
prompt_file: prompt.md
# Warm base pre-warm (dogfood): build one shared base of the target branch once, then
# materialize each agent workspace from it (copy-on-write) instead of cold-cloning.
# The build command lives in a sibling `.aiur/prewarm` script (path relative to
# this config), keeping the multi-line shell out of the main config.
prewarm:
  enabled: true
  base_build_file: prewarm
  poll_seconds: 0
