# === aiur workspace hooks ===
# Referenced from .aiur/config via `hooks_file: hooks`. These are the same hook
# keys you can inline under `hooks:` in the config — moved to their own file so
# multi-line shell scripts stay out of the main config and your coding agent can
# regenerate them independently.
#
# When `hooks_file:` is set it REPLACES any inline `hooks:` block; when absent
# the inline block (if any) is used unchanged.
#
# Env available to these hooks:
#   $THIS_REPOSITORY_URL   the repo aiur is working on (for a cold git clone)
#   $THIS_BASE_BRANCH      configured tracker base branch (defaults to main)
#   $AIUR_TICKET_BRANCH    generated canonical branch for this ticket
#
# Tune these for your repo's toolchain (mix, pnpm, cargo, go, …).

# Prepare a fresh per-issue workspace from the configured base branch. Aiur
# runs initial provisioning in an atomic staging directory, so this hook must
# never remove or clone into a nonempty live workspace itself.
after_create: |
  base_branch="${THIS_BASE_BRANCH:-main}"
  if [ -n "$(find . -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    echo "Aiur must stage incomplete workspace reconstruction before after_create runs." >&2
    exit 66
  fi
  git clone "$THIS_REPOSITORY_URL" .
  if git show-ref --verify --quiet "refs/remotes/origin/$AIUR_TICKET_BRANCH"; then
    git checkout -B "$AIUR_TICKET_BRANCH" "origin/$AIUR_TICKET_BRANCH"
  else
    git checkout -B "$AIUR_TICKET_BRANCH" "origin/$base_branch"
  fi

# Aiur stages empty, logs-only, and partial workspaces before this hook. The
# safeguard below prevents a direct invocation from overwriting live content.
# Re-establish the clone if the workspace is empty or half-initialized on resume.
# Otherwise refresh a clean checkout from the configured base before the next
# turn so agents do not continue from stale runbooks or safety scripts.
before_run: |
  base_branch="${THIS_BASE_BRANCH:-main}"
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
     ! git rev-parse --verify HEAD >/dev/null 2>&1 ||
     ! git status --porcelain >/dev/null 2>&1; then
    if [ -n "$(find . -mindepth 1 -maxdepth 1 -print -quit)" ]; then
      echo "Aiur must stage incomplete workspace reconstruction before before_run runs." >&2
      exit 66
    fi
    git clone "$THIS_REPOSITORY_URL" .
    if git show-ref --verify --quiet "refs/remotes/origin/$AIUR_TICKET_BRANCH"; then
      git checkout -B "$AIUR_TICKET_BRANCH" "origin/$AIUR_TICKET_BRANCH"
    else
      git checkout -B "$AIUR_TICKET_BRANCH" "origin/$base_branch"
    fi
  else
    git fetch origin "$base_branch"
    if ! git diff --quiet || ! git diff --cached --quiet; then
      echo "Refusing to refresh workspace from origin/$base_branch because tracked changes are present." >&2
      echo "Commit or resolve the workspace changes before resuming this agent." >&2
      exit 65
    fi
    git merge --no-edit "origin/$base_branch"
  fi

# Optional — run after each agent turn (e.g. format, quick checks):
# after_run: |
#   mix format

# Optional — run before the workspace is removed (e.g. close open PRs):
# before_remove: |
#   echo "cleaning up $(basename "$PWD")"
