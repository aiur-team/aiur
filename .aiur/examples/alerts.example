# Aiur alert sound mapping, scaffolded by `aiur init` as `.aiur/alerts`.
#
# This is the editable topic→sound map. It is only consulted when
# `alerts.use_os_default_sounds: false` in `.aiur/config`; with OS-default
# sounds on, the built-in macOS/Linux system sounds are used instead and this
# file is left for reference (and for the per-category overrides documented
# below). Playback is gated by `alerts.enabled` either way.
#
# ---------------------------------------------------------------------------
# Sound filenames
# ---------------------------------------------------------------------------
# Each entry's `sound:` is a list; one clip is picked at random per event.
# A value is resolved as:
#   - `~/foo.wav` or `/abs/foo.wav` — used as-is (the `~/alerts/*.wav` defaults
#     below assume you dropped clips in `~/alerts`).
#   - `http(s)://…`                 — played as a URL.
#   - a bare `name.wav`             — resolved inside `alerts.sound_dir` from
#                                     `.aiur/config` (so you can point a whole
#                                     folder of custom clips at the map at once).
#
# ---------------------------------------------------------------------------
# OS-default mode (`use_os_default_sounds: true`)
# ---------------------------------------------------------------------------
# Topics are bucketed into coarse categories (needs_input / stuck / done /
# default) and mapped to a built-in OS system sound. To override a single
# category, drop a `<category>.<ext>` file (e.g. `stuck.oga`) into
# `alerts.sound_dir`; it wins over the OS default for that category.
#
# ---------------------------------------------------------------------------
# Topic / glob matching (see lib/aiur/events/topic.ex)
# ---------------------------------------------------------------------------
#   - `*` matches exactly one topic segment
#   - `#` matches zero or more segments
#   - When multiple patterns match the same topic, the one with the most
#     literal segments wins (specificity sort, descending). Ties broken
#     lexicographically by pattern string.

alerts:
  # ---------- Ticket lifecycle (label-driven) -----------------------------
  "ticket.*.issue.label.added.agent.todo":
    message: Task entered todo
    sound:
      - "~/alerts/advisor-yes-executor.wav"
      - "~/alerts/advisor-your-will.wav"
      - "~/alerts/advisor-i-hear-you.wav"
      - "~/alerts/advisor-of-course.wav"
      - "~/alerts/advisor-for-adun.wav"
      - "~/alerts/advisor-terra-khala.wav"
      - "~/alerts/templar-yes-executor.wav"
      - "~/alerts/templar-consider-it-done.wav"
      - "~/alerts/templar-indeed.wav"
      - "~/alerts/templar-i-concur.wav"
      - "~/alerts/templar-state-your-will.wav"
      - "~/alerts/templar-i-am-ready.wav"
      - "~/alerts/archon-power-overwhelming.wav"
  "ticket.*.issue.label.added.agent.in-progress":
    message: Task picked up
  "ticket.*.issue.label.added.agent.human-review":
    message: Ready for human review
    sound:
      - "~/alerts/advisor-under-attack.wav"
      - "~/alerts/advisor-warriors-engaged-enemy.wav"
  "ticket.*.issue.label.added.agent.rework":
    message: Sent back for changes

  # ---------- Ticket lifecycle (GitHub-authoritative) ---------------------
  "ticket.*.pr.merged":
    message: Merge complete
    sound:
      - "~/alerts/archon-merging-complete.wav"
  "ticket.*.issue.state.changed":
    message: Task state changed
    sound:
      - "~/alerts/advisor-upgrade-complete.wav"

  # ---------- Orchestrator dispatch ---------------------------------------
  "system.dispatch.todo_capacity_exceeded":
    message: Todo queue exceeds capacity
    sound:
      - "~/alerts/advisor-not-enough-minerals.wav"
      - "~/alerts/advisor-additional-pylons.wav"

  # ---------- Agent state -------------------------------------------------
  "ticket.*.agent.error.tokens_exhausted":
    message: Agent ran out of tokens
    sound:
      - "~/alerts/advisor-not-enough-minerals.wav"
      - "~/alerts/advisor-require-more-vesphene-gas.wav"
  "ticket.*.agent.paused":
    message: Agent paused
    sound:
      - "~/alerts/advisor-yes-executor.wav"
      - "~/alerts/templar-yes-executor.wav"
  "ticket.*.agent.unpaused":
    message: Agent unpaused
    sound:
      - "~/alerts/advisor-your-will.wav"
      - "~/alerts/advisor-i-hear-you.wav"
      - "~/alerts/advisor-of-course.wav"
      - "~/alerts/advisor-for-adun.wav"
      - "~/alerts/advisor-terra-khala.wav"
      - "~/alerts/templar-yes-executor.wav"
      - "~/alerts/templar-consider-it-done.wav"
      - "~/alerts/templar-indeed.wav"
      - "~/alerts/templar-i-concur.wav"
      - "~/alerts/templar-state-your-will.wav"
      - "~/alerts/templar-i-am-ready.wav"
      - "~/alerts/archon-power-overwhelming.wav"

  # ---------- Chat lifecycle ----------------------------------------------
  "ticket.*.chat.opened":
    message: Chat opened
    sound:
      - "~/alerts/advisor-yes-executor.wav"
      - "~/alerts/templar-yes-executor.wav"
  "ticket.*.chat.closed":
    message: Chat closed
    sound:
      - "~/alerts/advisor-your-will.wav"
      - "~/alerts/advisor-i-hear-you.wav"
      - "~/alerts/advisor-of-course.wav"
      - "~/alerts/advisor-for-adun.wav"
      - "~/alerts/advisor-terra-khala.wav"
      - "~/alerts/templar-yes-executor.wav"
      - "~/alerts/templar-consider-it-done.wav"
      - "~/alerts/templar-indeed.wav"
      - "~/alerts/templar-i-concur.wav"
      - "~/alerts/templar-state-your-will.wav"
      - "~/alerts/templar-i-am-ready.wav"
      - "~/alerts/archon-power-overwhelming.wav"

  # ---------- Workflow phase milestones (agent-emitted) -------------------
  # Agents emit bare names like `brainstorm.start`; agent_runner prefixes
  # to `ticket.<id>.agent.<name>` before publish.
  "ticket.*.agent.brainstorm.start":
    message: Entered brainstorm
  "ticket.*.agent.brainstorm.end":
    message: Exited brainstorm
    sound:
      - "~/alerts/advisor-research-complete.wav"
  "ticket.*.agent.plan.start":
    message: Entered planning
  "ticket.*.agent.plan.end":
    message: Exited planning
    sound:
      - "~/alerts/advisor-research-complete.wav"
  "ticket.*.agent.work.start":
    message: Entered implementation
  "ticket.*.agent.work.end":
    message: Exited implementation
  "ticket.*.agent.review.start":
    message: Entered review
  "ticket.*.agent.review.end":
    message: Exited review
    sound:
      - "~/alerts/advisor-research-complete.wav"
