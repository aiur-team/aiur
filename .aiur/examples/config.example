# aiur configuration — annotated reference. `aiur init` fills {{PLACEHOLDERS}}; uncommented = essentials, commented = advanced defaults, omitted = built-in default.

# === Issue tracker ===
tracker:
  kind: {{TRACKER_KIND}}                 # github | linear | memory
  base_branch: {{BASE_BRANCH}}           # required integration branch; `aiur init` offers the repository default read from GitHub
  active_states: [todo, in-progress, rework, merging]
  terminal_states: [done, closed, cancelled, canceled]
  # terminal_fence_grace_seconds: 30   # how long a terminal tracker observation stays fenced for undelivered authoritative input before teardown; raise for longer provider turn-delivery latency
{{TRACKER_PROVIDER}}
  # provider block (filled above): github {repo, label_prefix, bot_account, trusted_accounts, human_mergers} | linear {api_key, project_slug, assignee}
  # bot_account is an IDENTITY, not a credential: the daemon authenticates with a
  # GitHub App installation token when GITHUB_APP_ID/GITHUB_APP_INSTALLATION_ID and
  # the App private key are set (preferred; see docs/security/daemon-token-posture.md),
  # else the GITHUB_TOKEN PAT in .env. bot_account is the login Aiur recognizes as its
  # own to suppress self-triggered comment/event loops. It must name the identity the
  # daemon actually writes as: under GitHub App auth that is the App's bot user,
  # `<app-slug>[bot]` — NOT the PAT account. A stale PAT login here silently disables
  # self-loop suppression; the daemon alerts on the mismatch at startup
  # (system.github_app_token.identity_mismatch). On the PAT path, prefer a dedicated bot
  # account (e.g. its-applekid) when operators also comment
  # from a trusted CODEOWNER account — reusing one login makes agent-vs-human provenance ambiguous.
  # human_mergers is an explicit human-only list used for post-merge attribution alerts. It never
  # inherits CODEOWNERS, bot_account, trusted_accounts, or dispatch allowed_users.

# === Coding agents ===
agent:
  # Ordered dispatch preference (replaces `kind` + `switch_model_on_ratelimit` +
  # `backend_configs.<b>.enabled`). Presence in the array makes a backend
  # dispatchable; the first available entry is the default backend; and when a
  # backend hits a token or usage limit aiur automatically falls back to the
  # next one in the list, returning to an earlier one once it recovers.
  priority: {{PRIORITY}}                   # e.g. [deepseek, codex, claude]
  # kind: {{AGENT_KIND}}                   # deprecated; use `priority` instead
  max_concurrent_agents: {{MAX_AGENTS}}  # global cap on simultaneously-running agents
  # max_concurrent_builds: 2             # fleet cap for agent mix compile/test; 0 disables only this cap
  # Coordination errors fail the requested mix command with status 125.
  # build_start_stagger_seconds: 5       # minimum spacing between concurrent mix compile/test starts; 0 = disabled
  # min_free_memory_mb: 4096             # hold new dispatch + local mix compile/test below this MemAvailable floor
  # Full emergency opt-out: set both build settings above to 0 and leave min_free_memory_mb omitted.
  max_turns: {{MAX_TURNS}}               # per-issue turn cap (cost guard); `none` = unlimited
  # max_turns_by_complexity: {1: 4, 2: 8, 3: 12, 4: 20, 5: 30}  # overrides max_turns for labeled tickets
  max_agent_duration_minutes: {{MAX_AGENT_DURATION}}  # safety checkpoint; 0 = never auto-pause
  # synthetic_load_process_cap: null     # per-agent cap for `yes`/`stress` load generators; null = cores/4, 0 = disabled
  routing: {{ROUTING}}                   # complexity:<N> label -> backend[:model[:effort]]; prefer a family alias (codex:terra:high, claude:opus) over a pinned version, which expires
  prior_work_continuation: true           # cold redispatch/backend switch continues from shared workspace context, never a cross-provider transcript
  # backend_configs:                      # optional overrides keyed by registry instance
  #   deepseek: {balance_baseline: 100}   # prepaid-balance seed; enablement now comes from `priority` presence
  #   openrouter: {model: moonshotai/kimi-k2.7-code} # explicit underlying model required
  claude:
    command: aiur-claude
    permission_mode: {{PERMISSION_MODE}} # bypassPermissions (default/acceptEdits need an approval UI — coming soon)
    # model: claude-sonnet-4-6           # omit to use the claude CLI's own default
  codex:
    command: codex app-server
    approval_policy: never            # never prompt for approval (headless autonomy); see codex variants to gate
    # thread_sandbox: workspace-write
    # danger-full-access defaults turns to dangerFullAccess unless turn_sandbox_policy is set
    # default workspace-write turns allow network access so local build tools can open loopback sockets
    # read_timeout_ms: 5000
    # thrash_max_per_window: 6
    # thrash_window_seconds: 60
  # --- advanced agent tuning (defaults shown) ---
  # mix_scheduler_cap: 4                 # cap each agent Mix VM (and ExUnit's default max_cases)
  # saturation_log_enabled: true         # saturation sentinel (#1429): record VM+host diagnostics once load crosses the escalation threshold
  # max_retry_attempts: 3
  # max_retry_backoff_ms: 300000
  # turn_timeout_ms: 3600000             # backstop per turn (any backend)
  # stall_timeout_ms: 3600000            # watchdog for a silent agent (60 min; long test/coverage runs are silent)
  # max_load_average: 1.5                # load ceiling, CPU-corroborated; set null to disable
  # target_load_average: 1.0             # per-scheduler adaptive target; set null to disable envelope
  # load_ramp_step: 1                    # slots added per below-target poll
  # load_cooldown_seconds: 60            # minimum seconds between high-load decreases
  # remote_control: false                # always attach Claude remote control to RC-capable agents

# === Workspace & per-repo agent prompt ===
workspace:
  root: {{WORKSPACE_ROOT}}               # where agents clone and work
  # bootstrap_image: ghcr.io/aiur-team/aiur:latest  # optional: seed missing build caches from this image after checkout refresh
  # bootstrap_image_pull: true            # pull the image before seeding; false uses the local image if present
prompt_file: {{PROMPT_FILE}}             # per-repo agent prompt appended to each turn

# === Workspace bootstrap hooks ===
# Workspace shell hooks (NOT git hooks) in a separate `.aiur/hooks` file, path relative to this config; inline a `hooks:` block here instead if you prefer.
hooks_file: hooks

# === Polling / concurrency ===
polling:
  # Tracker re-check cadence and fleet-capacity starvation alert debounce.
  interval_seconds: {{POLLING}}
  idle_widen_factor: 5.0                 # multiply the interval while no agents are active; operator/webhook wakes remain immediate
  view_state_sweep_seconds: 900          # the single view-state reconciliation sweep; recovers lost webhook deliveries, not a freshness knob
max_vertical_panes: 3                    # max agent chat panes shown at once
pre_warmed_sessions: {{PRE_WARMED}}      # opencode sessions pre-booted for fast open

# === Warm base pre-warm (opt-in; `aiur init` sets this up) ===
# aiur builds ONE warm, pre-compiled checkout of the configured tracker base and spins each agent
# workspace off it (copy-on-write) instead of every agent cloning + building from scratch.
prewarm:
  enabled: {{PREWARM_ENABLED}}           # turn on to pre-warm a shared base before agents dispatch
{{PREWARM_BASE_BUILD_FILE}}  poll_seconds: 0                        # background base refresh interval (s); 0 = refresh eagerly/lazily only

# === Alert sound effects (opt-in; play a sound when an agent is stuck or needs input) ===
alerts:
  enabled: {{ALERTS_ENABLED}}                  # master switch for alert sound playback (macOS + Linux)
  use_os_default_sounds: {{ALERTS_OS_SOUNDS}}  # true = built-in OS system sounds; false = topic→sound map below
  # sound_dir: ~/alerts                        # custom sound folder: resolves the map's filenames, and (in OS-default mode) a <category>.<ext> file here overrides that category
  alerts_file: alerts                          # topic→sound map; a relative path resolves next to this config (edit `.aiur/alerts`). Use an absolute or ~/ path to point elsewhere; a missing file falls back to the default `.aiur/alerts` next to the config

# === Executor takeover advisories (advanced defaults shown) ===
# While a nonterminal ticket stays in the run scope, aiur watches its convergence age
# (durable first-active-work time floored by the open PR's creation time) and raises an
# advisory needs-attention alert once it crosses the first threshold, then repeats at the
# continuous cadence until the ticket resolves or leaves scope. Advisory only — aiur never
# takes over a ticket automatically. `0` disables the corresponding alert; negative values
# are rejected.
# executor_takeover_first_alert_hours: 8     # first advisory after this many hours of convergence
# executor_takeover_continuous_alert_hours: 1 # repeat cadence (hours) while unresolved; 0 = first alert only
{{ELEVENLABS_SECTION}}
# === Repo-wide PR comment watching (opt-in; OFF by default) ===
# Let aiur act on comments across the whole repo, not just its own aiur/<id> PRs.
# Requires github.bot_account (reply identity) and CODEOWNERS / github.trusted_accounts (who may direct the agent).
# pr_watch:
#   enabled: false           # true = act on comments on watched/commanded PRs repo-wide
#   watch_label: watch        # label a PR `<label_prefix>:watch` (e.g. agent:watch) to monitor all its code-owner/trusted comments
#   command_prefix: /aiur     # a trusted comment starting with this (or mentioning github.bot_account) handles that one comment, no label needed

# === Build Order providers (optional; in-memory only) ===
# Supervised providers fetch configured-repository detail and retain sanitized typed ticket history.
# Restarting Aiur clears their snapshots; consumers receive unavailable state until a new read succeeds.
# build_order:
#   # These three default to values derived from polling.interval_seconds, because
#   # Build Order cannot be fresher than the tracker cycle that feeds it. Set one
#   # only to override that. At a 120s poll interval the derived values are shown.
#   # graph_selected_refresh_ms and graph_demand_refresh_ms no longer exist: they
#   # were how viewing bought GitHub reads. A selected root is read when a writer
#   # or an explicit refresh asks for it, so holding the page open costs nothing.
#   ticket_detail_freshness_ms: 30000       # 1..300000; reuse a healthy detail during this window
#   graph_catalog_refresh_ms: 120000        # daemon-owned root-catalog reconciliation interval
#   graph_catalog_labels_refresh_ms: 600000 # slower cadence for the costlier read that resolves epic/wave counts
#   graph_refresh_timeout_ms: 30000         # bounded provider task timeout
#   graph_max_selected_roots: 32            # in-memory retained LKG roots; lost on daemon restart
#   graph_max_inflight: 4                    # provider refreshes shared by all connected consumers
#   ticket_detail_max_entries: 32            # 1..100; retained ticket identities, independent of browser count
#   ticket_detail_max_description_bytes: 16384 # 1..16384; bounded sanitized provider description
#   ticket_history_limit: 50                  # 1..100; retained allowlisted recent-history entries per ticket
#   ticket_history_max_identities: 100        # 1..100; retained configured-repository ticket histories
#   ticket_history_stale_after_ms: 60000      # 1..300000; floor for the typed-activity freshness window (the effective window is at least two poll intervals)

# --- advanced (top-level; defaults shown, uncomment to override) ---
# debug: false                           # true = always run in debug mode (verbose logs + debug UI), no --debug flag needed; --debug still wins
# max_log_history_mb: 1000               # cap on total ~/.aiur/logs size (swept every 5 min)
# opencode: { command: opencode, bridge_port: 4097, bridge_host: 127.0.0.1, model_prefix: aiur }
# observability: { dashboard_enabled: true, refresh_ms: 1000, render_interval_ms: 16, telemetry_enabled: true, telemetry_retention_max_bytes: 67108864, telemetry_retention_max_age_days: 30, telemetry_retention_prune_interval_bytes: 8388608 }
# decisions: { supervisor_allowed_kinds: [], supervisor_allow_non_reversible: false }
# server: { port: 4000 }                # host omitted = authenticated Tailscale IP when available, else loopback; add host: 127.0.0.1 to pin loopback
# worker: { ssh_hosts: [], max_concurrent_agents_per_host: 4 }
# events: { block_state_debounce_seconds: 10, custom_events_per_turn_max: 5, codeowners_refresh_seconds: 3600 }
# upgrade: { check_enabled: true }     # `aiur run` version notice: TTL-cached npm check (fails open/silent; channel-aware); false = suppress the check entirely (zero outbound). Env: AIUR_UPGRADE_CHECK_DISABLED
