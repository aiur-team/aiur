# aiur configuration — annotated reference. `aiur init` fills {{PLACEHOLDERS}}; uncommented = essentials, commented = advanced defaults, omitted = built-in default.

# === Issue tracker ===
tracker:
  kind: {{TRACKER_KIND}}                 # github | linear | memory
  active_states: [todo, in-progress, rework, merging]
  terminal_states: [done, cancelled, canceled]
{{TRACKER_PROVIDER}}
  # provider block (filled above): github {repo, label_prefix, bot_account, trusted_accounts} | linear {api_key, project_slug, assignee}

# === Coding agents ===
agent:
  kind: {{AGENT_KIND}}                   # default backend: codex | claude
  max_concurrent_agents: {{MAX_AGENTS}}  # global cap on simultaneously-running agents
  # max_concurrent_builds: 2             # fleet cap for agent mix compile/test; 0 disables only this cap
  # Coordination errors fail the requested mix command with status 125.
  # build_start_stagger_seconds: 5       # minimum spacing between concurrent mix compile/test starts; 0 = disabled
  # min_free_memory_mb: 4096             # hold new dispatch + local mix compile/test below this MemAvailable floor
  # Full emergency opt-out: set both build settings above to 0 and leave min_free_memory_mb omitted.
  max_turns: {{MAX_TURNS}}               # per-issue turn cap (cost guard); `none` = unlimited
  # max_turns_by_complexity: {1: 4, 2: 8, 3: 12, 4: 20, 5: 30}  # overrides max_turns for labeled tickets
  max_agent_duration_minutes: {{MAX_AGENT_DURATION}}  # safety checkpoint; 0 = never auto-pause
  # synthetic_load_process_cap: null     # per-agent cap for `yes`/`stress` load generators; null = cores/4, 0 = disabled
  routing: {{ROUTING}}                   # complexity:<N> label -> backend[:model[:effort]], e.g. codex:gpt-5.6-terra:high
{{RATE_LIMIT_FALLBACK}}  # opt-in default-ticket fallback order; explicit labels/routing are never changed
  claude:
    command: aiur-claude
    permission_mode: {{PERMISSION_MODE}} # bypassPermissions (default/acceptEdits need an approval UI — coming soon)
    # model: claude-sonnet-4-6           # omit to use the claude CLI's own default
  codex:
    command: codex app-server
    approval_policy: never            # never prompt for approval (headless autonomy); see codex variants to gate
    # thread_sandbox: workspace-write
    # danger-full-access defaults turns to dangerFullAccess unless turn_sandbox_policy is set
    # default workspace-write turns allow network access so local build tools can open loopback sockets
    # read_timeout_ms: 5000
    # thrash_max_per_window: 6
    # thrash_window_seconds: 60
  # --- advanced agent tuning (defaults shown) ---
  # mix_scheduler_cap: 4                 # cap each agent Mix VM (and ExUnit's default max_cases)
  # max_retry_attempts: 3
  # max_retry_backoff_ms: 300000
  # turn_timeout_ms: 3600000             # backstop per turn (any backend)
  # stall_timeout_ms: 3600000            # watchdog for a silent agent (60 min; long test/coverage runs are silent)
  # max_load_average: 1.5                # per-scheduler load gate; set null to disable
  # target_load_average: 1.0             # per-scheduler adaptive target; set null to disable envelope
  # load_ramp_step: 1                    # slots added per below-target poll
  # load_cooldown_seconds: 60            # minimum seconds between high-load decreases
  # remote_control: false                # always attach Claude remote control to RC-capable agents

# === Workspace & per-repo agent prompt ===
workspace:
  root: {{WORKSPACE_ROOT}}               # where agents clone and work
  # bootstrap_image: ghcr.io/its-everdred/aiur:latest  # optional: seed missing build caches from this image after checkout refresh
  # bootstrap_image_pull: true            # pull the image before seeding; false uses the local image if present
prompt_file: {{PROMPT_FILE}}             # per-repo agent prompt appended to each turn

# === Workspace bootstrap hooks ===
# Workspace shell hooks (NOT git hooks) in a separate `.aiur/hooks` file, path relative to this config; inline a `hooks:` block here instead if you prefer.
hooks_file: hooks

# === Polling / concurrency ===
polling:
  interval_seconds: {{POLLING}}          # how often aiur re-checks the tracker for issues to pick up
max_vertical_panes: 3                    # max agent chat panes shown at once
pre_warmed_sessions: {{PRE_WARMED}}      # opencode sessions pre-booted for fast open

# === Warm base pre-warm (opt-in; `aiur init` sets this up) ===
# aiur builds ONE warm, pre-compiled checkout of the configured tracker base and spins each agent
# workspace off it (copy-on-write) instead of every agent cloning + building from scratch.
prewarm:
  enabled: {{PREWARM_ENABLED}}           # turn on to pre-warm a shared base before agents dispatch
{{PREWARM_BASE_BUILD_FILE}}  poll_seconds: 0                        # background base refresh interval (s); 0 = refresh eagerly/lazily only

# === Alert sound effects (opt-in; play a sound when an agent is stuck or needs input) ===
alerts:
  enabled: {{ALERTS_ENABLED}}                  # master switch for alert sound playback (macOS + Linux)
  use_os_default_sounds: {{ALERTS_OS_SOUNDS}}  # true = built-in OS system sounds; false = topic→sound map below
  # sound_dir: ~/alerts                        # custom sound folder: resolves the map's filenames, and (in OS-default mode) a <category>.<ext> file here overrides that category
  alerts_file: alerts                          # topic→sound map; a relative path resolves next to this config (edit `.aiur/alerts`). Use an absolute or ~/ path to point elsewhere; a missing file falls back to the default `.aiur/alerts` next to the config

# === Repo-wide PR comment watching (opt-in; OFF by default) ===
# Let aiur act on comments across the whole repo, not just its own aiur/<id> PRs.
# Requires github.bot_account (reply identity) and CODEOWNERS / github.trusted_accounts (who may direct the agent).
# pr_watch:
#   enabled: false           # true = act on comments on watched/commanded PRs repo-wide
#   watch_label: watch        # label a PR `<label_prefix>:watch` (e.g. agent:watch) to monitor all its code-owner/trusted comments
#   command_prefix: /aiur     # a trusted comment starting with this (or mentioning github.bot_account) handles that one comment, no label needed

# === Build Order ticket detail cache (optional; in-memory only) ===
# One supervised provider fetches selected configured-repository GitHub tickets on demand.
# Restarting Aiur clears this cache; consumers receive unavailable state until a new read succeeds.
# build_order:
#   ticket_detail_freshness_ms: 30000       # 1..300000; reuse a healthy detail during this window
#   ticket_detail_max_entries: 32            # 1..100; retained ticket identities, independent of browser count
#   ticket_detail_max_description_bytes: 16384 # 1..16384; bounded sanitized provider description

# --- advanced (top-level; defaults shown, uncomment to override) ---
# debug: false                           # true = always run in debug mode (verbose logs + debug UI), no --debug flag needed; --debug still wins
# max_log_history_mb: 1000               # cap on total ~/.aiur/logs size (swept every 5 min)
# opencode: { command: opencode, bridge_port: 4097, bridge_host: 127.0.0.1, model_prefix: aiur }
# observability: { dashboard_enabled: true, refresh_ms: 1000, render_interval_ms: 16 }
# decisions: { supervisor_allowed_kinds: [], supervisor_allow_non_reversible: false }
# server: { host: 127.0.0.1, port: 4000 }
# worker: { ssh_hosts: [], max_concurrent_agents_per_host: 4 }
# events: { block_state_debounce_seconds: 10, custom_events_per_turn_max: 5, codeowners_refresh_seconds: 3600 }
