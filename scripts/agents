#!/usr/bin/env bash
set -euo pipefail

default_repo_root="/home/applekid/github/its-applekid/symphony"
repo_root="${AGENTS_REPO_ROOT:-$default_repo_root}"
config_file="${AGENTS_CONFIG_FILE:-$HOME/.config/symphony/agents.profiles}"
env_file="${AGENTS_ENV_FILE:-$HOME/.config/symphony-dashboard.env}"
mise_bin="${AGENTS_MISE_BIN:-$HOME/.local/bin/mise}"
systemctl_bin="${AGENTS_SYSTEMCTL_BIN:-systemctl}"
pkill_bin="${AGENTS_PKILL_BIN:-pkill}"
default_foreground_mode="${AGENTS_FOREGROUND_MODE:-tui}"

declare -a profile_names=()
declare -A profile_symphony_roots=()
declare -A profile_workflows=()
declare -A profile_ports=()
declare -A profile_logs_roots=()
declare -A profile_services=()

usage() {
  cat <<'USAGE'
Usage: agents [list|stop [profile|all]|--bg [profile|all]|run [profile]|tui [profile]|profile|<workflow-path>]

Without args, restart the other configured services and run the default profile in the interactive TUI.
With run, stop a profile's background service and run that profile in the passive foreground CLI.
With tui, stop a profile's background service and run that profile in the interactive TUI.
With a profile name, run that profile's workflow in the interactive TUI.
With --bg, restart background services only and return. Defaults to the default profile.
With all, restart the other configured services and run the default profile in the interactive TUI.
With stop, stop a profile, every profile, or ad hoc foreground Symphony processes.

Profiles are loaded from ~/.config/symphony/agents.profiles when present.
Each non-comment line uses:
  name|symphony_root|workflow|port|logs_root|service

The workflow can be absolute, which lets profiles keep WORKFLOW.md files in
their target repositories while using one Symphony checkout to run them.
USAGE
}

add_profile() {
  local name="$1"
  local root="$2"
  local workflow="$3"
  local port="${4:-}"
  local logs_root="${5:-}"
  local service="${6-symphony}"

  if [ -z "$name" ] || [ -z "$root" ] || [ -z "$workflow" ]; then
    return
  fi

  if ! profile_exists "$name"; then
    profile_names+=("$name")
  fi

  profile_symphony_roots["$name"]="$root"
  profile_workflows["$name"]="$workflow"
  profile_ports["$name"]="$port"
  profile_logs_roots["$name"]="$logs_root"
  profile_services["$name"]="$service"
}

profile_exists() {
  local name="$1"

  for profile in "${profile_names[@]}"; do
    if [ "$profile" = "$name" ]; then
      return 0
    fi
  done

  return 1
}

load_profiles() {
  add_profile "default" "$repo_root" "WORKFLOW.md" "" "" "symphony"
  add_profile "symphony" "$repo_root" "WORKFLOW.symphony.md" "" "" "symphony"

  if [ -r "$config_file" ]; then
    while IFS='|' read -r name root workflow port logs_root service extra; do
      name="$(trim "$name")"

      if [ -z "$name" ] || [[ "$name" == \#* ]]; then
        continue
      fi

      if [ -n "${extra:-}" ]; then
        echo "Invalid profile line for '$name': expected 6 fields" >&2
        exit 64
      fi

      add_profile \
        "$name" \
        "$(trim "$root")" \
        "$(trim "$workflow")" \
        "$(trim "${port:-}")" \
        "$(trim "${logs_root:-}")" \
        "$(trim "${service:-}")"
    done <"$config_file"
  fi
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

profile_elixir_dir() {
  local profile="$1"
  printf '%s/elixir' "${profile_symphony_roots[$profile]}"
}

profile_workflow_arg() {
  local profile="$1"
  local workflow="${profile_workflows[$profile]}"

  if [[ "$workflow" = /* ]]; then
    printf '%s' "$workflow"
  else
    printf './%s' "$workflow"
  fi
}

require_profile() {
  local profile="$1"

  if ! profile_exists "$profile"; then
    echo "Unknown profile: $profile" >&2
    echo >&2
    usage >&2
    exit 64
  fi
}

list_profiles() {
  printf '%-16s %-36s %-24s %-8s %-24s %s\n' "PROFILE" "SYMPHONY" "WORKFLOW" "PORT" "LOGS" "SERVICE"

  for profile in "${profile_names[@]}"; do
    printf '%-16s %-36s %-24s %-8s %-24s %s\n' \
      "$profile" \
      "${profile_symphony_roots[$profile]}" \
      "${profile_workflows[$profile]}" \
      "${profile_ports[$profile]:--}" \
      "${profile_logs_roots[$profile]:--}" \
      "${profile_services[$profile]:--}"
  done
}

stop_profile() {
  local profile="$1"
  local elixir_dir
  local workflow
  local service

  require_profile "$profile"

  elixir_dir="$(profile_elixir_dir "$profile")"
  workflow="$(profile_workflow_arg "$profile")"
  service="${profile_services[$profile]}"

  if [ -n "$service" ] && command -v "$systemctl_bin" >/dev/null 2>&1; then
    "$systemctl_bin" --user stop "$service" >/dev/null 2>&1 || true
  fi

  if [[ "$workflow" = /* ]]; then
    "$pkill_bin" -f "$workflow" 2>/dev/null || true
  else
    "$pkill_bin" -f "$elixir_dir/${workflow#./}" 2>/dev/null || true
    "$pkill_bin" -f "$elixir_dir/$workflow" 2>/dev/null || true
  fi
  "$pkill_bin" -f "$elixir_dir.*bin/symphony" 2>/dev/null || true
}

stop_all() {
  for profile in "${profile_names[@]}"; do
    stop_profile "$profile"
  done
}

restart_profile_background() {
  local profile="$1"
  local service

  require_profile "$profile"
  service="${profile_services[$profile]}"

  if [ -z "$service" ]; then
    echo "Profile '$profile' has no systemd service configured" >&2
    exit 64
  fi

  "$systemctl_bin" --user restart "$service"
  "$systemctl_bin" --user status "$service" --no-pager
}

restart_all_background() {
  local seen_services=" "
  local service

  for profile in "${profile_names[@]}"; do
    service="${profile_services[$profile]}"

    if [ -n "$service" ] && [[ "$seen_services" != *" $service "* ]]; then
      seen_services="${seen_services}${service} "
      "$systemctl_bin" --user restart "$service"
      "$systemctl_bin" --user status "$service" --no-pager
    fi
  done
}

restart_background_except_profile() {
  local foreground_profile="$1"
  local foreground_service="${profile_services[$foreground_profile]}"
  local seen_services=" "
  local service

  for profile in "${profile_names[@]}"; do
    service="${profile_services[$profile]}"

    if [ -n "$service" ] && [ "$service" != "$foreground_service" ] && [[ "$seen_services" != *" $service "* ]]; then
      seen_services="${seen_services}${service} "
      "$systemctl_bin" --user restart "$service"
      "$systemctl_bin" --user status "$service" --no-pager
    fi
  done
}

run_foreground() {
  local profile="$1"
  local mode="${2:-passive}"
  local elixir_dir
  local workflow
  local port
  local logs_root
  local args=()

  require_profile "$profile"
  stop_profile "$profile"

  elixir_dir="$(profile_elixir_dir "$profile")"
  workflow="$(profile_workflow_arg "$profile")"
  port="${profile_ports[$profile]}"
  logs_root="${profile_logs_roots[$profile]}"

  cd "$elixir_dir"

  if [ -r "$env_file" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$env_file"
    set +a
  fi

  if [ "$mode" = "tui" ]; then
    args=(exec -- mix run -e 'SymphonyElixir.CLI.main(System.argv())' -- --tui)
  else
    args=(exec -- ./bin/symphony)
  fi

  if [ -n "$logs_root" ]; then
    args+=(--logs-root "$logs_root")
  fi

  if [ -n "$port" ]; then
    args+=(--port "$port")
  fi

  args+=(--i-understand-that-this-will-be-running-without-the-usual-guardrails "$workflow")

  exec "$mise_bin" "${args[@]}"
}

run_ad_hoc_workflow() {
  local workflow="$1"

  add_profile "__adhoc__" "$repo_root" "$workflow" "" "" ""
  run_foreground "__adhoc__" "$default_foreground_mode"
}

run_all_with_foreground() {
  local foreground_profile="${1:-default}"
  local mode="${2:-$default_foreground_mode}"

  require_profile "$foreground_profile"
  restart_background_except_profile "$foreground_profile"
  run_foreground "$foreground_profile" "$mode"
}

load_profiles

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  list)
    list_profiles
    exit 0
    ;;
  --bg)
    target="${2:-default}"

    if [ "$target" = "all" ]; then
      restart_all_background
    else
      restart_profile_background "$target"
    fi

    exit 0
    ;;
  all)
    run_all_with_foreground "default" "$default_foreground_mode"
    ;;
  run)
    run_foreground "${2:-default}"
    ;;
  tui)
    run_foreground "${2:-default}" "tui"
    ;;
  stop)
    target="${2:-all}"

    if [ "$target" = "all" ]; then
      stop_all
    else
      stop_profile "$target"
    fi

    exit 0
    ;;
  "")
    run_all_with_foreground "default" "$default_foreground_mode"
    ;;
  default)
    run_foreground "default" "$default_foreground_mode"
    ;;
  *.md | /*)
    run_ad_hoc_workflow "$1"
    ;;
  *)
    run_foreground "$1" "$default_foreground_mode"
    ;;
esac
