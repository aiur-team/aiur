#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
default_repo_root="$(cd "$script_dir/.." && pwd)"
repo_root="${AGENTS_REPO_ROOT:-$default_repo_root}"
config_file="${AGENTS_CONFIG_FILE:-$HOME/.config/symphony/agents.profiles}"
env_file="${AGENTS_ENV_FILE:-$HOME/.config/symphony-dashboard.env}"
mise_bin="${AGENTS_MISE_BIN:-$(command -v mise 2>/dev/null || true)}"
systemctl_bin="${AGENTS_SYSTEMCTL_BIN:-systemctl}"
pkill_bin="${AGENTS_PKILL_BIN:-pkill}"
nohup_bin="${AGENTS_NOHUP_BIN:-nohup}"
kill_bin="${AGENTS_KILL_BIN:-kill}"
tmux_bin="${AGENTS_TMUX_BIN:-$(command -v tmux 2>/dev/null || echo tmux)}"
bg_state_dir="${AGENTS_BG_STATE_DIR:-$HOME/.local/state/symphony}"

agents_os="${AGENTS_OS_OVERRIDE:-$(uname -s)}"

# --host: when present, let the workflow's configured host stand (typical for
# Tailscale or LAN exposure). When absent, the wrapper injects
# `--host 127.0.0.1` so a default `agents` run binds locally only.
expose_host=0
debug_mode=0
filtered_args=()
for arg in "$@"; do
  case "$arg" in
    --host)
      expose_host=1
      ;;
    --debug)
      debug_mode=1
      ;;
    *)
      filtered_args+=("$arg")
      ;;
  esac
done

if [ "$debug_mode" -eq 1 ]; then
  export SYMPHONY_DEBUG=1
fi

# Refuse to run inside an existing tmux session — Symphony spawns its own
# isolated tmux on a dedicated socket and does not nest cleanly. Detected
# via the `$TMUX` env var, which is set inside every shell tmux owns.
if [ -n "${TMUX:-}" ]; then
  echo "agents: already inside a tmux session (\$TMUX is set)" >&2
  echo "Open a fresh terminal without tmux and try again." >&2
  exit 1
fi

if [ "${#filtered_args[@]}" -gt 0 ]; then
  set -- "${filtered_args[@]}"
else
  set --
fi

declare -a profile_names=()
declare -a profile_symphony_roots=()
declare -a profile_workflows=()
declare -a profile_ports=()
declare -a profile_logs_roots=()
declare -a profile_services=()

usage() {
  cat <<'USAGE'
Usage: agents [list|stop [profile|all]|--bg [profile|all]|run [profile]|profile|<workflow-path>]

Without args, restart the other configured services and run the default profile in the foreground.
With run, stop a profile's background service and run that profile in the foreground.
With a profile name, run that profile's workflow in the foreground.
With --bg, restart background services only and return. Defaults to the default profile.
With all, restart the other configured services and run the default profile in the foreground.
With stop, stop a profile, every profile, or ad hoc foreground Symphony processes.

Options:
  --debug              enable verbose debug logging (sets SYMPHONY_DEBUG=1).
                       Tail logs in another terminal:
                         tail -F elixir/log/symphony.log
  --host               leave the workflow's configured host alone (default
                       binds to 127.0.0.1 for loopback-only access).

Foreground dashboard controls:
  j/k or arrows        move between running agents
  space, enter, or i   open the selected agent conversation
  enter                send the typed message
  alt-enter            insert a newline while typing
  esc or ctrl-c        return from conversation to agent selection
  q                    quit from navigation mode

Profiles are loaded from ~/.config/symphony/agents.profiles when present.
Each non-comment line uses:
  name|symphony_root|workflow|port|logs_root|service

The workflow can be absolute, which lets profiles keep WORKFLOW.md files in
their target repositories while using one Symphony checkout to run them.
USAGE
}

add_profile() {
  local name="$1"
  local root="$2"
  local workflow="$3"
  local port="${4:-}"
  local logs_root="${5:-}"
  local service="${6-symphony}"

  if [ -z "$name" ] || [ -z "$root" ] || [ -z "$workflow" ]; then
    return
  fi

  if ! profile_exists "$name"; then
    profile_names+=("$name")
    profile_symphony_roots+=("$root")
    profile_workflows+=("$workflow")
    profile_ports+=("$port")
    profile_logs_roots+=("$logs_root")
    profile_services+=("$service")
    return
  fi

  local index
  index="$(profile_index "$name")"
  profile_symphony_roots[$index]="$root"
  profile_workflows[$index]="$workflow"
  profile_ports[$index]="$port"
  profile_logs_roots[$index]="$logs_root"
  profile_services[$index]="$service"
}

profile_index() {
  local name="$1"
  local i

  for ((i = 0; i < ${#profile_names[@]}; i++)); do
    if [ "${profile_names[$i]}" = "$name" ]; then
      printf '%s' "$i"
      return 0
    fi
  done

  return 1
}

profile_exists() {
  profile_index "$1" >/dev/null
}

profile_value() {
  local array_name="$1"
  local profile="$2"
  local index

  index="$(profile_index "$profile")" || return 1

  case "$array_name" in
    symphony_root) printf '%s' "${profile_symphony_roots[$index]}" ;;
    workflow) printf '%s' "${profile_workflows[$index]}" ;;
    port) printf '%s' "${profile_ports[$index]}" ;;
    logs_root) printf '%s' "${profile_logs_roots[$index]}" ;;
    service) printf '%s' "${profile_services[$index]}" ;;
    *) return 1 ;;
  esac
}

load_profiles() {
  add_profile "default" "$repo_root" "local-workflows/WORKFLOW.symphony.local.md" "" "" "symphony"
  add_profile "symphony" "$repo_root" "local-workflows/WORKFLOW.symphony.local.md" "" "" "symphony"
  add_profile "actions" "$repo_root" "local-workflows/WORKFLOW.actions.local.md" "" "" "symphony-actions"

  if [ -r "$config_file" ]; then
    while IFS='|' read -r name root workflow port logs_root service extra; do
      name="$(trim "$name")"

      if [ -z "$name" ] || [[ "$name" == \#* ]]; then
        continue
      fi

      if [ -n "${extra:-}" ]; then
        echo "Invalid profile line for '$name': expected 6 fields" >&2
        exit 64
      fi

      add_profile \
        "$name" \
        "$(trim "$root")" \
        "$(trim "$workflow")" \
        "$(trim "${port:-}")" \
        "$(trim "${logs_root:-}")" \
        "$(trim "${service:-}")"
    done <"$config_file"
  fi
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

profile_elixir_dir() {
  local profile="$1"
  printf '%s/elixir' "$(profile_value symphony_root "$profile")"
}

profile_workflow_arg() {
  local profile="$1"
  local workflow
  workflow="$(profile_value workflow "$profile")"

  if [[ "$workflow" = /* ]]; then
    printf '%s' "$workflow"
  else
    printf './%s' "$workflow"
  fi
}

require_profile() {
  local profile="$1"

  if ! profile_exists "$profile"; then
    echo "Unknown profile: $profile" >&2
    echo >&2
    usage >&2
    exit 64
  fi
}

list_profiles() {
  printf '%-16s %-36s %-24s %-8s %-24s %s\n' "PROFILE" "SYMPHONY" "WORKFLOW" "PORT" "LOGS" "SERVICE"

  local i

  for ((i = 0; i < ${#profile_names[@]}; i++)); do
    printf '%-16s %-36s %-24s %-8s %-24s %s\n' \
      "${profile_names[$i]}" \
      "${profile_symphony_roots[$i]}" \
      "${profile_workflows[$i]}" \
      "${profile_ports[$i]:--}" \
      "${profile_logs_roots[$i]:--}" \
      "${profile_services[$i]:--}"
  done
}

load_env_file() {
  local path="$1"

  if [ -r "$path" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$path"
    set +a
  fi
}

require_mise() {
  if [ -z "$mise_bin" ] || [ ! -x "$mise_bin" ]; then
    echo "agents: mise not found on PATH. Install mise (https://mise.jdx.dev) or set AGENTS_MISE_BIN." >&2
    exit 64
  fi
}

ensure_built() {
  local elixir_dir="$1"
  local symphony_bin="$elixir_dir/bin/symphony"

  # AGENTS_SKIP_BUILD lets the test fixture short-circuit this without faking
  # `mix escript.build` invocations on top of every other stubbed binary.
  if [ "${AGENTS_SKIP_BUILD:-0}" = "1" ]; then
    return 0
  fi

  if [ ! -x "$symphony_bin" ]; then
    build_symphony "$elixir_dir"
    return
  fi

  # If any source file is newer than the escript, rebuild. `-quit` stops after
  # the first hit; output is discarded — we only care about the exit signal.
  if [ -n "$(find "$elixir_dir/lib" "$elixir_dir/mix.exs" "$elixir_dir/mix.lock" \
              -newer "$symphony_bin" -print -quit 2>/dev/null)" ]; then
    build_symphony "$elixir_dir"
  fi
}

build_symphony() {
  local elixir_dir="$1"

  require_mise
  echo "agents: rebuilding bin/symphony…" >&2
  (cd "$elixir_dir" && "$mise_bin" exec -- mix escript.build) >&2
}

source_env_files() {
  # Order: home-dir env first, then repo-local .env (overrides), then
  # .env.local (machine-specific override). All optional.
  load_env_file "$env_file"
  load_env_file "$repo_root/.env"
  load_env_file "$repo_root/.env.local"
}

ensure_bg_state_dir() {
  mkdir -p "$bg_state_dir"
}

# Distribution setup for the upcoming per-agent pane subcommand. The cookie
# lives in ~/.erlang.cookie (auto-read by the BEAM) so it does NOT leak through
# /proc/<pid>/environ. The wrapper validates ownership and length each run.
ensure_erlang_cookie() {
  local cookie_file="$HOME/.erlang.cookie"

  if [ ! -f "$cookie_file" ]; then
    (
      umask 0177
      tmp_file="$(mktemp "$HOME/.erlang.cookie.XXXXXX")"
      head -c 32 /dev/urandom | base64 | tr -d '\n=+/' | head -c 32 >"$tmp_file"
      mv "$tmp_file" "$cookie_file"
    )
    chmod 0400 "$cookie_file"
  fi

  if [ ! -r "$cookie_file" ]; then
    echo "agents: ~/.erlang.cookie is not readable" >&2
    return 1
  fi

  if [ "$(stat -c '%U' "$cookie_file" 2>/dev/null || stat -f '%Su' "$cookie_file")" != "$USER" ]; then
    echo "agents: ~/.erlang.cookie is not owned by $USER" >&2
    return 1
  fi

  local size
  size="$(wc -c <"$cookie_file" | tr -d ' ')"

  if [ "$size" -lt 16 ]; then
    echo "agents: ~/.erlang.cookie is shorter than 16 bytes" >&2
    return 1
  fi
}

prepare_distribution() {
  ensure_erlang_cookie || return 1

  local host_short
  host_short="$(hostname -s 2>/dev/null || hostname)"
  local node_name="symphony-${USER}@${host_short}"

  # Read the cookie file's contents and pass it explicitly via -setcookie.
  # ESCripts do not always pick up ~/.erlang.cookie automatically (some BEAM
  # boot paths skip the auto-load), and a silent cookie mismatch shows up as
  # `Node.connect/1 -> false` with no obvious cause — so we make it explicit.
  local cookie
  cookie="$(cat "$HOME/.erlang.cookie")"

  # Force IPv4 distribution and pin to 127.0.0.1 — hostnames on some boxes
  # resolve to IPv6 first, while the BEAM's distribution port binds to
  # 0.0.0.0 (IPv4 only). The mismatch shows up as `Node.connect -> false`
  # with no helpful error.
  export ERL_AFLAGS="${ERL_AFLAGS:-} -sname symphony-${USER} -setcookie ${cookie} -proto_dist inet_tcp -kernel inet_dist_use_interface '{127,0,0,1}'"
  export ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"
  export SYMPHONY_NODE="${SYMPHONY_NODE:-$node_name}"

  # Export the cookie under our own name so the pane-side wrapper can pick
  # it up even when it replaces ERL_AFLAGS for a unique -sname.
  export SYMPHONY_ERLANG_COOKIE="$cookie"
}

ensure_symphony_state_dir() {
  mkdir -p -m 0700 "$HOME/.config/symphony" 2>/dev/null || true
}

check_tmux() {
  if ! "$tmux_bin" -V >/dev/null 2>&1; then
    echo "agents: tmux is not installed or not executable; install tmux >= 3.3 before launching" >&2
    return 1
  fi

  return 0
}

bg_pid_file() {
  printf '%s/%s.pid' "$bg_state_dir" "$1"
}

bg_log_file() {
  printf '%s/%s.log' "$bg_state_dir" "$1"
}

stop_bg_pidfile() {
  local service="$1"
  local pid_file
  local pid

  if [ -z "$service" ]; then
    return 0
  fi

  pid_file="$(bg_pid_file "$service")"

  if [ ! -f "$pid_file" ]; then
    return 0
  fi

  pid="$(cat "$pid_file" 2>/dev/null || true)"

  if [ -n "$pid" ]; then
    "$kill_bin" -TERM "$pid" 2>/dev/null || true
  fi

  rm -f "$pid_file"
}

stop_profile() {
  local profile="$1"
  local elixir_dir
  local workflow
  local service
  local logs_root
  local port

  require_profile "$profile"

  elixir_dir="$(profile_elixir_dir "$profile")"
  workflow="$(profile_workflow_arg "$profile")"
  service="$(profile_value service "$profile")"
  logs_root="$(profile_value logs_root "$profile")"
  port="$(profile_value port "$profile")"

  case "$agents_os" in
    Darwin*)
      stop_bg_pidfile "$service"
      ;;
    *)
      if [ -n "$service" ] && command -v "$systemctl_bin" >/dev/null 2>&1; then
        "$systemctl_bin" --user stop "$service" >/dev/null 2>&1 || true
      fi
      ;;
  esac

  if [[ "$workflow" = /* ]]; then
    "$pkill_bin" -f "$workflow" 2>/dev/null || true
    "$pkill_bin" -f "bin/symphony .*--interactive.*$workflow" 2>/dev/null || true
  else
    "$pkill_bin" -f "$elixir_dir/${workflow#./}" 2>/dev/null || true
    "$pkill_bin" -f "$elixir_dir/$workflow" 2>/dev/null || true
    "$pkill_bin" -f "bin/symphony .*--interactive.*${workflow#./}" 2>/dev/null || true
    "$pkill_bin" -f "bin/symphony .*--interactive.*$workflow" 2>/dev/null || true
  fi

  if [ -n "$logs_root" ]; then
    "$pkill_bin" -f "bin/symphony .*--interactive.*--logs-root $logs_root" 2>/dev/null || true
  fi

  if [ -n "$port" ]; then
    "$pkill_bin" -f "bin/symphony .*--interactive.*--port $port" 2>/dev/null || true
  fi

  "$pkill_bin" -f "$elixir_dir.*bin/symphony" 2>/dev/null || true
}

stop_all() {
  for profile in "${profile_names[@]}"; do
    stop_profile "$profile"
  done
}

start_bg_nohup() {
  local profile="$1"
  local elixir_dir
  local workflow
  local port
  local logs_root
  local service
  local pid_file
  local log_file
  local args=()

  elixir_dir="$(profile_elixir_dir "$profile")"
  workflow="$(profile_workflow_arg "$profile")"
  port="$(profile_value port "$profile")"
  logs_root="$(profile_value logs_root "$profile")"
  service="$(profile_value service "$profile")"

  ensure_built "$elixir_dir"

  ensure_bg_state_dir
  pid_file="$(bg_pid_file "$service")"
  log_file="$(bg_log_file "$service")"

  stop_bg_pidfile "$service"

  (
    cd "$elixir_dir"

    source_env_files

    args=(exec -- ./bin/symphony)

    if [ -n "$logs_root" ]; then
      args+=(--logs-root "$logs_root")
    fi

    if [ -n "$port" ]; then
      args+=(--port "$port")
    fi

    if [ "$expose_host" -eq 0 ]; then
      args+=(--host 127.0.0.1)
    fi

    args+=(--i-understand-that-this-will-be-running-without-the-usual-guardrails "$workflow")

    "$nohup_bin" "$mise_bin" "${args[@]}" >"$log_file" 2>&1 &
    echo $! >"$pid_file"
    disown
  )

  printf '%s started in background (pid file: %s, log: %s)\n' "$service" "$pid_file" "$log_file"
}

restart_one_background_service() {
  local profile="$1"
  local service
  service="$(profile_value service "$profile")"

  case "$agents_os" in
    Darwin*)
      start_bg_nohup "$profile"
      ;;
    *)
      "$systemctl_bin" --user restart "$service"
      "$systemctl_bin" --user status "$service" --no-pager
      ;;
  esac
}

restart_profile_background() {
  local profile="$1"
  local service

  require_profile "$profile"
  service="$(profile_value service "$profile")"

  if [ -z "$service" ]; then
    echo "Profile '$profile' has no background service configured" >&2
    exit 64
  fi

  restart_one_background_service "$profile"
}

restart_all_background() {
  local seen_services=" "
  local service

  for profile in "${profile_names[@]}"; do
    service="$(profile_value service "$profile")"

    if [ -n "$service" ] && [[ "$seen_services" != *" $service "* ]]; then
      seen_services="${seen_services}${service} "
      restart_one_background_service "$profile"
    fi
  done
}

restart_background_except_profile() {
  local foreground_profile="$1"
  local foreground_service
  foreground_service="$(profile_value service "$foreground_profile")"
  local seen_services=" "
  local service

  for profile in "${profile_names[@]}"; do
    service="$(profile_value service "$profile")"

    if [ -n "$service" ] && [ "$service" != "$foreground_service" ] && [[ "$seen_services" != *" $service "* ]]; then
      seen_services="${seen_services}${service} "
      restart_one_background_service "$profile"
    fi
  done
}

run_foreground() {
  local profile="$1"
  local elixir_dir
  local workflow
  local port
  local logs_root
  local symphony_args=()

  require_profile "$profile"
  stop_profile "$profile"

  elixir_dir="$(profile_elixir_dir "$profile")"
  workflow="$(profile_workflow_arg "$profile")"
  port="$(profile_value port "$profile")"
  logs_root="$(profile_value logs_root "$profile")"

  ensure_built "$elixir_dir"

  cd "$elixir_dir"

  source_env_files
  ensure_symphony_state_dir
  check_tmux || die "tmux >= 3.3 is required; install tmux before running agents"
  prepare_distribution || die "distribution setup failed; cannot launch agent-list pane"

  symphony_args=(exec -- ./bin/symphony)

  if [ -n "$logs_root" ]; then
    symphony_args+=(--logs-root "$logs_root")
  fi

  if [ -n "$port" ]; then
    symphony_args+=(--port "$port")
  fi

  if [ "$expose_host" -eq 0 ]; then
    symphony_args+=(--host 127.0.0.1)
  fi

  symphony_args+=(--interactive --i-understand-that-this-will-be-running-without-the-usual-guardrails "$workflow")

  run_in_tmux "$profile" "$elixir_dir" "${symphony_args[@]}"
}

die() {
  echo "agents: $*" >&2
  exit 1
}

symphony_tmux_session_name() {
  local profile="$1"
  printf 'symphony-%s-%s' "${USER:-user}" "$profile"
}

symphony_tmux_socket_name() {
  printf 'symphony-%s' "${USER:-user}"
}

resolve_symphony_tmux_conf() {
  local override="${SYMPHONY_TMUX_CONF:-}"
  if [ -n "$override" ] && [ -f "$override" ]; then
    printf '%s\n' "$override"
    return
  fi

  local user_conf="${XDG_CONFIG_HOME:-$HOME/.config}/symphony/tmux.conf"
  if [ -f "$user_conf" ]; then
    printf '%s\n' "$user_conf"
    return
  fi

  printf '%s\n' "$script_dir/symphony.tmux.conf"
}

run_in_tmux() {
  local profile="$1"
  local elixir_dir="$2"
  shift 2

  local session socket conf
  session="$(symphony_tmux_session_name "$profile")"
  socket="$(symphony_tmux_socket_name)"
  conf="$(resolve_symphony_tmux_conf)"

  if [ ! -f "$conf" ]; then
    die "tmux conf not found at $conf"
  fi

  # Persist session/socket/conf so the conversation pane subcommand and the
  # Elixir Tmux client can target the same isolated server.
  printf '%s\n' "$session" >"$HOME/.config/symphony/state"
  export SYMPHONY_TMUX_SESSION="$session"
  export SYMPHONY_TMUX_SOCKET="$socket"
  export SYMPHONY_TMUX_CONF="$conf"
  export SYMPHONY_BIN="$elixir_dir/bin/symphony"
  export SYMPHONY_MISE_BIN="$mise_bin"

  if [ "$debug_mode" -eq 1 ]; then
    echo "agents: debug logging enabled" >&2
    echo "agents: tail logs with -> tail -F $elixir_dir/log/symphony.log" >&2
    echo "agents: tmux socket=$socket conf=$conf" >&2
  fi

  if "$tmux_bin" -L "$socket" -f "$conf" has-session -t "$session" 2>/dev/null; then
    "$tmux_bin" -L "$socket" -f "$conf" kill-session -t "$session" 2>/dev/null || true
  fi

  # Build the inner command as a single string for tmux to exec inside its
  # pane. We change into the elixir dir and call mise with the supplied args.
  local inner_cmd
  printf -v inner_cmd 'cd %q && exec %q' "$elixir_dir" "$mise_bin"

  local arg
  for arg in "$@"; do
    printf -v inner_cmd '%s %q' "$inner_cmd" "$arg"
  done

  "$tmux_bin" -L "$socket" -f "$conf" new-session -d -s "$session" \
    -x "${COLUMNS:-200}" -y "${LINES:-50}" "$inner_cmd"

  # In the foreground, the user attaches to the session normally.
  exec "$tmux_bin" -L "$socket" -f "$conf" attach -t "$session"
}

run_ad_hoc_workflow() {
  local workflow="$1"

  add_profile "__adhoc__" "$repo_root" "$workflow" "" "" ""
  run_foreground "__adhoc__"
}

load_profiles

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  list)
    list_profiles
    exit 0
    ;;
  build)
    build_symphony "$repo_root/elixir"
    exit 0
    ;;
  --bg)
    target="${2:-default}"

    if [ "$target" = "all" ]; then
      restart_all_background
    else
      restart_profile_background "$target"
    fi

    exit 0
    ;;
  run)
    run_foreground "${2:-default}"
    ;;
  stop)
    target="${2:-all}"

    if [ "$target" = "all" ]; then
      stop_all
    else
      stop_profile "$target"
    fi

    exit 0
    ;;
  "" | default)
    run_foreground "default"
    ;;
  *.md | /*)
    run_ad_hoc_workflow "$1"
    ;;
  *)
    run_foreground "$1"
    ;;
esac
