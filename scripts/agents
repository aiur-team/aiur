#!/usr/bin/env bash
set -euo pipefail

repo_root="/home/applekid/github/its-applekid/symphony"
elixir_dir="$repo_root/elixir"
env_file="/home/applekid/.config/symphony-dashboard.env"
mise_bin="/home/applekid/.local/bin/mise"

usage() {
  cat <<'USAGE'
Usage: agents [--bg|stop|symphony|<workflow-path>]

Without flags, stop the background service and run Symphony in the foreground.
With --bg, restart the standard background systemd user service.
With stop, stop the background service and any foreground Symphony process for this repo.
With symphony, run the Symphony self-workflow in the foreground.
With a workflow path, run that workflow in the foreground.
USAGE
}

stop_agents() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user stop symphony >/dev/null 2>&1 || true
  fi

  pkill -f "$elixir_dir/WORKFLOW.md" 2>/dev/null || true
  pkill -f "$elixir_dir/./WORKFLOW.md" 2>/dev/null || true
  pkill -f "$elixir_dir.*bin/symphony" 2>/dev/null || true
}

workflow="./WORKFLOW.md"

case "${1:-}" in
  --bg)
    systemctl --user restart symphony
    systemctl --user status symphony --no-pager
    exit 0
    ;;
  stop)
    stop_agents
    exit 0
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  "")
    ;;
  symphony)
    workflow="./WORKFLOW.symphony.md"
    ;;
  *.md | /*)
    workflow="$1"
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac

stop_agents

cd "$elixir_dir"

if [ -r "$env_file" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
fi

exec "$mise_bin" exec -- ./bin/symphony \
  --i-understand-that-this-will-be-running-without-the-usual-guardrails \
  "$workflow"
