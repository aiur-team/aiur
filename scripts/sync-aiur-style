#!/usr/bin/env bash
# Refresh the committed dashboard copy of the aiur-style build output (run `npm run build` in packages/aiur-style first).
# An optional absolute target directory gets the aiur-style/ copy instead; CI syncs to a temp dir and diffs it.
set -euo pipefail
cd "$(dirname "$0")/.."
node packages/aiur-style/scripts/sync.mjs "${1:-src/priv/static}" --only css,js,init,fonts,assets,tokens
