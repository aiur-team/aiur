#!/usr/bin/env bash
#
# aiurdev — dev shim for the aiur launcher engine.
#
# Runs the SAME engine the installed `aiur` runs, but against this repo's local
# `mix release` (rebuilding it when stale) instead of an npm-installed platform
# package. It shares the installed `aiur` distribution identity; the only
# difference is which release runs (AIUR_RELEASE_DIR). Every subcommand lives in
# packaging/npm/aiur-cli/libexec/aiur-engine.sh — this file owns only the
# repo-local release resolution and the dev build-if-stale step.
set -euo pipefail

# Resolve the repo root, following a symlink (e.g. ~/.local/bin/aiurdev -> here)
# so script_dir is the real scripts/ dir, not the symlink's parent.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
script_dir="$(cd -P "$(dirname "$src")" && pwd)"

# Where repo_root came from decides whether a cwd mismatch is a mistake or a
# deliberate choice: an explicit AIUR_REPO_ROOT states the target outright, the
# path-derived default only infers one from where the script (or its symlink
# target) happens to live.
if [ -n "${AIUR_REPO_ROOT:-}" ]; then
  # Canonicalize: a trailing slash or a symlinked path would otherwise fail the
  # physical-path comparisons below, silently disabling provenance and the
  # targeting check on a root that is perfectly valid.
  repo_root="$(cd -P "$AIUR_REPO_ROOT" 2>/dev/null && pwd || printf '%s' "$AIUR_REPO_ROOT")"
  repo_root_source="AIUR_REPO_ROOT"
else
  repo_root="$(cd -P "$script_dir/.." && pwd)"
  repo_root_source="script-path"
fi

elixir_dir="$repo_root/src"
release_dir="$elixir_dir/_build/dev/rel/aiur"
release_stamp="$release_dir/AIUR_BUILD_STAMP"
build_lock_dir="$elixir_dir/_build/.aiurdev-build.lock"
engine="$repo_root/packaging/npm/aiur-cli/libexec/aiur-engine.sh"
mise_bin="${AIUR_MISE_BIN:-$(command -v mise 2>/dev/null || true)}"

# --- checkout targeting -------------------------------------------------------
# repo_root is derived from this script's path, which is deliberate: a globally
# symlinked `aiurdev` (~/.local/bin/aiurdev -> <checkout>/scripts/aiurdev) has to
# work from any directory. The cost is that the target is invisible — standing in
# checkout B and running the symlink compiles into, and boots, checkout A, and
# every step reports success. That is how a rebuild-and-bounce ships a release
# from a tree the operator never touched.
#
# So the path-derived default stands, but it may not silently disagree with where
# the operator is standing: when the cwd is inside a DIFFERENT aiur checkout, the
# commands that write a release or boot one refuse and name both roots.

# Walk up from the physical cwd for the checkout it belongs to. All three markers
# are required — they are exactly what this shim needs from a repo root, so a
# partial tree (a docs-only clone, an unrelated repo with a scripts/ dir) never
# matches and never triggers a spurious refusal.
enclosing_aiur_checkout() {
  local dir
  dir="$(pwd -P 2>/dev/null || true)"

  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    if [ -f "$dir/scripts/aiurdev" ] &&
      [ -f "$dir/packaging/npm/aiur-cli/libexec/aiur-engine.sh" ] &&
      [ -f "$dir/src/mix.exs" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

# The command the ENGINE will see, which is not always "$1": the shim consumes
# its own dev-only flags before dispatch, so `aiurdev --debug status` is still a
# control command and must be classified as one.
effective_command() {
  local arg

  for arg in "$@"; do
    case "$arg" in
      --debug | --clear | --allow-remote) ;;
      *)
        printf '%s\n' "$arg"
        return 0
        ;;
    esac
  done

  # Nothing left: a bare run.
  return 0
}

# Commands whose PURPOSE is to produce a release or boot one. For these a
# mismatch is the defect itself and refusing costs nothing — re-run from the
# right directory. Everything else is a control, informational, or RPC command
# that only wants to reach the running daemon; refusing those would trade a
# build nobody asked for against a fleet that cannot be answered, so they are
# handled by not building instead (see guard_checkout_target).
#
# Every named engine subcommand is listed, so the fallthrough means "an
# unrecognized token", which for this shim is a bare run, a run flag, or a
# config path — all of which boot a release. Drift therefore lands on the
# refusing side, which is loud and immediately fixable, never on the silent one.
targets_release_deliberately() {
  case "${1:-}" in
    build | restart) return 0 ;;
    agents | alerts | status | set | pause | resume | stop | message | cleanup-stale | reset-budget) return 1 ;;
    watch | init | findings | guard-pr-deletions | __identity) return 1 ;;
    help | -h | -help | --h | --help | --version | --todo | --only) return 1 ;;
    ask | asks | usage | commands | units | build-orders | analytics | github-cost | github-usage) return 1 ;;
    executor-*) return 1 ;;
    *) return 0 ;;
  esac
}

refuse_diverging_checkout() {
  local cwd_root="$1" cmd="$2" shim_name args=""
  shift 2
  shim_name="$(basename "$src")"

  # %q so a config path with spaces comes back as a line the operator can paste.
  if [ "$#" -gt 0 ]; then
    printf -v args ' %q' "$@"
  fi

  echo "❌ aiurdev would target a different checkout than the one you are in" >&2
  echo "   you are in    : $cwd_root" >&2
  echo "   would target  : $repo_root (resolved from the aiurdev script path)" >&2
  echo "   command       : ${cmd:-<run>}" >&2
  echo >&2
  echo "   Building or booting there would report success while leaving the release" >&2
  echo "   you are working on untouched. Pick one:" >&2
  echo >&2
  echo "   # target the checkout you are in" >&2
  echo "   $cwd_root/scripts/$shim_name$args" >&2
  echo "   # target the other checkout on purpose" >&2
  echo "   AIUR_REPO_ROOT=$repo_root $shim_name$args" >&2
  exit 64
}

# Set when the cwd belongs to a different checkout than the one being targeted.
# The dispatch block reads it to keep a control command off the build path: the
# release in the OTHER checkout is one a live daemon may be booted from, and
# rewriting it in place to answer an RPC is the same silent damage as building
# it on purpose.
checkout_diverges=0

guard_checkout_target() {
  local cwd_root cmd shim_name

  # An explicit AIUR_REPO_ROOT already states the intent this guard exists to
  # confirm, so it is the documented escape hatch as well as the override.
  if [ "$repo_root_source" = "AIUR_REPO_ROOT" ]; then
    return 0
  fi

  cmd="$(effective_command "$@")"

  if ! cwd_root="$(enclosing_aiur_checkout)"; then
    # No checkout to compare against. Name the target anyway for the commands
    # that will write or boot a release: standing outside every checkout is the
    # other way to lose track of which tree a build lands in.
    if targets_release_deliberately "$cmd"; then
      echo "ℹ️  aiurdev targeting $repo_root (resolved from the aiurdev script path)" >&2
    fi
    return 0
  fi

  if [ "$cwd_root" = "$repo_root" ]; then
    return 0
  fi

  if targets_release_deliberately "$cmd"; then
    refuse_diverging_checkout "$cwd_root" "$cmd" "$@"
  fi

  shim_name="$(basename "$src")"

  # Reusing the other checkout's release is only harmless while there IS one.
  # `ensure_control_surface` repairs a missing release by building it, which
  # from here is the same silent foreign build under a different name — so this
  # is the one control-command case that still has to refuse.
  if ! release_ready; then
    echo "❌ aiurdev cannot run this against $repo_root without building it" >&2
    echo "   you are in    : $cwd_root" >&2
    echo "   would target  : $repo_root (resolved from the aiurdev script path)" >&2
    echo "   That checkout has no complete release, so reaching its daemon would" >&2
    echo "   compile one there — a checkout you are not working in." >&2
    echo >&2
    echo "   # use the checkout you are in" >&2
    echo "   $cwd_root/scripts/$shim_name ${cmd:-}" >&2
    echo "   # or build the other one on purpose first" >&2
    echo "   AIUR_REPO_ROOT=$repo_root $shim_name build" >&2
    exit 64
  fi

  # Otherwise a control or RPC command still has to reach the daemon — refusing
  # `executor-answer` would leave a blocked agent unanswerable over a build it
  # never needed. So it runs, but it says which checkout it is speaking through
  # and is kept off the build path.
  checkout_diverges=1
  echo "ℹ️  aiurdev is speaking through $repo_root, not the checkout you are in" >&2
  echo "   ($cwd_root). Its existing release is reused and nothing is built there." >&2
  echo "   Use $cwd_root/scripts/$shim_name to act on this checkout instead." >&2
}

require_mise() {
  if [ -z "$mise_bin" ] || [ ! -x "$mise_bin" ]; then
    echo "❌ mise not found on PATH. Install mise (https://mise.jdx.dev) or set AIUR_MISE_BIN." >&2
    return 64
  fi
}

# The release inherits this script's environment. Put the version pinned by
# this repository ahead of any globally-installed opencode so the server and
# its SQLite migrations use the schema Aiur has validated.
ensure_pinned_opencode() {
  local opencode_dir

  require_mise || return 64
  opencode_dir="$("$mise_bin" where -C "$repo_root" opencode 2>/dev/null || true)"

  if [ -z "$opencode_dir" ] || [ ! -x "$opencode_dir/opencode" ]; then
    echo "❌ pinned opencode is unavailable; run mise install in $repo_root" >&2
    return 64
  fi

  export PATH="$opencode_dir:$PATH"
}

requires_pinned_opencode() {
  local cmd="${1:-}"

  # Match the shared engine's dispatch boundary: only commands that can start
  # an Aiur session need OpenCode. Control and utility commands must remain
  # usable against an existing daemon when the local tool install is missing.
  case "$cmd" in
    "" | run | restart | --bg) return 0 ;;
    help | -h | -help | --h | --help | --version | --todo | --only | init | findings | guard-pr-deletions) return 1 ;;
    agents | alerts | status | set | pause | resume | stop | message | cleanup-stale | watch | reset-budget) return 1 ;;
    -*) return 0 ;;
    *) [ -e "$cmd" ] ;;
  esac
}

elixir_deps_ready() {
  local deps_dir="$elixir_dir/deps" dep
  [ -d "$elixir_dir/_build" ] && [ -d "$deps_dir" ] || return 1
  [ -f "$elixir_dir/mix.lock" ] || return 0
  while IFS= read -r dep; do
    [ -n "$dep" ] && [ ! -d "$deps_dir/$dep" ] && return 1
  done < <(sed -n 's/^  "\([^"]*\)":.*/\1/p' "$elixir_dir/mix.lock")
  return 0
}

ensure_elixir_deps() {
  if ! elixir_deps_ready; then
    require_mise || return 64
    echo "🔨 fetching and compiling Hex dependencies" >&2
    (cd "$elixir_dir" && "$mise_bin" exec -- mix deps.get && "$mise_bin" exec -- mix compile) >&2
  fi
}

# True only when repo_root is itself the root of a git work tree. `git -C` walks
# UP to the nearest enclosing repository, so a repo_root that merely sits inside
# some other checkout would otherwise be stamped with that outer repository's
# commit — provenance for a tree nobody built. A linked worktree reports its own
# path here, so worktrees are handled like any other root.
repo_is_git_root() {
  local toplevel

  command -v git >/dev/null 2>&1 || return 1
  toplevel="$(git -C "$repo_root" rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$toplevel" ] || return 1

  [ "$(cd -P "$toplevel" 2>/dev/null && pwd)" = "$repo_root" ]
}

# The SHA of the tree a build would produce a release FROM. "unknown" whenever
# git cannot answer (no git on PATH, a tarball export); callers treat unknown as
# "no provenance available" rather than as a mismatch, so a gitless checkout
# keeps working exactly as before.
repo_head_sha() {
  local sha=""

  if repo_is_git_root; then
    sha="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || true)"
  fi

  printf '%s\n' "${sha:-unknown}"
}

read_stamp_field() {
  local field="$1" file="$2"
  [ -r "$file" ] || return 1
  sed -n "s/^$field=//p" "$file" | head -n 1
}

# A release is otherwise opaque: file mtimes say when it was assembled but not
# which checkout or which commit produced it, which is why the debug playbook
# tells operators to report a release SHA of "unknown". Stamping it makes the
# provenance readable — and makes `restart` able to prove what it is booting.
# Takes the SHA the build STARTED from. A release assembly runs for minutes, and
# a commit or branch switch landing inside that window would otherwise stamp a
# commit the release demonstrably was not built from — provenance that reads as
# current forever after.
write_release_stamp() {
  local source_sha="$1" dirty="unknown"

  if repo_is_git_root; then
    if [ -n "$(git -C "$repo_root" status --porcelain 2>/dev/null)" ]; then
      dirty="yes"
    else
      dirty="no"
    fi
  fi

  printf 'repo_root=%s\nsource_sha=%s\ndirty=%s\nbuilt_at=%s\n' \
    "$repo_root" "$source_sha" "$dirty" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >"$release_stamp"
}

release_ready() {
  [ -x "$elixir_dir/bin/aiur" ] || return 1
  [ -x "$release_dir/bin/aiur" ] || return 1
  [ -r "$release_dir/releases/start_erl.data" ] || return 1

  local release_vsn
  release_vsn="$(cut -d' ' -f2 "$release_dir/releases/start_erl.data" 2>/dev/null || true)"
  [ -n "$release_vsn" ] || return 1
  [ -x "$release_dir/releases/$release_vsn/elixir" ] || return 1
  [ -r "$release_dir/releases/$release_vsn/start_clean.boot" ] || return 1
  [ -r "$release_dir/releases/$release_vsn/vm.args" ] || return 1
  [ -r "$release_dir/releases/$release_vsn/sys.config" ] || return 1

  local epmd epmd_found=0
  for epmd in "$release_dir"/erts-*/bin/epmd; do
    [ -x "$epmd" ] && epmd_found=1 && break
  done
  [ "$epmd_found" -eq 1 ] || return 1
}

# Tracks whether THIS process acquired the lock, so the crash-net trap can only
# ever remove a lock it actually owns. `release_build_lock` also re-verifies the
# recorded owner before removing, so a stale-reclaim takeover by another
# invocation (whose owner PID may look live in PID-isolated shells) is never
# deleted out from under it.
build_lock_held=0

acquire_build_lock() {
  local owner_pid waited=0

  build_lock_held=0
  mkdir -p "$elixir_dir/_build"
  until mkdir "$build_lock_dir" 2>/dev/null; do
    if [ "$waited" -eq 0 ]; then
      echo "⏳ waiting for aiurdev rebuild lock" >&2
      waited=1
    fi

    if [ -r "$build_lock_dir/owner" ]; then
      owner_pid="$(awk '{print $1}' "$build_lock_dir/owner" 2>/dev/null || true)"
      if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
        rm -rf "$build_lock_dir"
        continue
      fi
    fi

    sleep 0.2
  done

  printf '%s %s\n' "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$build_lock_dir/owner" 2>/dev/null || true
  build_lock_held=1
}

release_build_lock() {
  local owner_pid

  [ "$build_lock_held" -eq 1 ] || return 0
  owner_pid="$(awk '{print $1}' "$build_lock_dir/owner" 2>/dev/null || true)"
  if [ "$owner_pid" = "$$" ]; then
    rm -rf "$build_lock_dir"
  fi
  build_lock_held=0
}

build_aiur() {
  local log_file status=0 source_sha

  require_mise || return 64
  # Read before the compile, not after — see write_release_stamp.
  source_sha="$(repo_head_sha)"
  echo "🔨 rebuilding bin/aiur (compile + release)" >&2
  log_file="$(mktemp "${TMPDIR:-/tmp}/aiurdev-release.XXXXXX")"

  if (cd "$elixir_dir" && "$mise_bin" exec -- mix compile --force && "$mise_bin" exec -- mix release --overwrite) >"$log_file" 2>&1; then
    status=0
  else
    status=$?
  fi

  grep -v -E "^(\* assembling|\* skipping runtime|Generated aiur app|Release created at|    _build|    # |Once the release is running:|To list all commands:|$)" "$log_file" >&2 || true
  rm -f "$log_file"

  if [ "$status" -ne 0 ]; then
    echo "❌ aiur release rebuild failed; removing incomplete release" >&2
    rm -rf "$release_dir"
    return "$status"
  fi

  if ! release_ready; then
    echo "❌ aiur release rebuild did not produce a complete release; removing incomplete release" >&2
    rm -rf "$release_dir"
    return 1
  fi

  write_release_stamp "$source_sha"
}

# A release built from a commit other than the one checked out now is stale even
# when no source file is newer than it: `git switch` and `git reset --hard` both
# leave a tree whose mtimes lose to a release assembled afterwards. The mtime
# sweep is kept for the dirty-tree case it does answer (edits since the build).
release_matches_head() {
  local stamped current

  stamped="$(read_stamp_field source_sha "$release_stamp" || true)"
  # No stamp means the release predates provenance stamping or was assembled by
  # something else. Either way nothing vouches for it, so rebuild rather than
  # extend it the benefit of the doubt.
  [ -n "$stamped" ] || return 1

  # Unknown on BOTH sides means this checkout has no provenance to compare at
  # all (no git, a tarball export); fall back to the mtime sweep rather than
  # rebuilding on every single launch. Unknown on one side only is a mismatch
  # like any other, so one rebuild converges the stamp onto whatever this host
  # can actually attest — which keeps `restart` able to check it.
  current="$(repo_head_sha)"
  if [ "$stamped" = "unknown" ] && [ "$current" = "unknown" ]; then
    return 0
  fi

  [ "$stamped" = "$current" ]
}

# Rebuild the release when the shim/release is missing, built from another
# commit, or any source is newer.
ensure_built_locked() {
  ensure_elixir_deps

  if ! release_ready; then
    build_aiur
    return
  fi

  if ! release_matches_head; then
    build_aiur
    return
  fi

  if [ -n "$(find "$elixir_dir/lib" "$elixir_dir/mix.exs" "$elixir_dir/mix.lock" \
    -newer "$elixir_dir/bin/aiur" -print -quit 2>/dev/null)" ]; then
    build_aiur
  fi
}

ensure_built() {
  local status=0

  [ "${AIUR_SKIP_BUILD:-0}" = "1" ] && return 0

  acquire_build_lock
  trap 'release_build_lock' EXIT INT TERM
  ensure_built_locked || status=$?
  release_build_lock
  trap - EXIT INT TERM
  return "$status"
}

# `aiur restart` runs this shim's rebuild in a separate process, so the engine
# cannot see what that rebuild targeted — a build that succeeded against another
# tree exits 0 exactly like a correct one. The receipt is how the builder tells
# the engine which release it is vouching for and from which commit, so the
# engine can check that claim against the release it is about to boot instead of
# assuming it. Absent AIUR_RESTART_BUILD_RECEIPT this is a plain no-op, which is
# what every non-restart invocation is.
write_restart_receipt() {
  [ -n "${AIUR_RESTART_BUILD_RECEIPT:-}" ] || return 0

  printf 'release_dir=%s\nrepo_root=%s\nsource_sha=%s\n' \
    "$release_dir" "$repo_root" "$(repo_head_sha)" \
    >"$AIUR_RESTART_BUILD_RECEIPT"
}

pure_control_command() {
  local cmd="${1:-}"

  case "$cmd" in
    agents | alerts | status | set | pause | resume | stop | message | cleanup-stale | reset-budget | github-cost | github-usage) return 0 ;;
    *) return 1 ;;
  esac
}

# `restart` owns its own rebuild, which the engine runs AFTER the stop (see
# AIUR_RESTART_BUILD_CMD). Rebuilding here as well would put the rebuild back on
# the wrong side of the stop — in-place over the release the live BEAM is booted
# from — so the pre-dispatch step must only guarantee a release complete enough
# to issue that stop, never a fresh one.
builds_after_stop() {
  [ "${1:-}" = "restart" ]
}

ensure_control_surface() {
  local status=0

  [ "${AIUR_SKIP_BUILD:-0}" = "1" ] && return 0

  # A running daemon is compatible with the complete release that launched it,
  # even when another shell is rebuilding for a future run. Control commands
  # must not wait behind that rebuild lock just to query or stop the daemon.
  release_ready && return 0

  acquire_build_lock
  trap 'release_build_lock' EXIT INT TERM
  if ! release_ready; then
    ensure_built_locked || status=$?
  fi
  release_build_lock
  trap - EXIT INT TERM
  return "$status"
}

in_agent_workspace_tree() {
  local marker="${AIUR_AGENT_WORKSPACE:-}"
  if [ -n "$marker" ]; then
    printf '%s\n' "$marker"
    return 0
  fi

  case "$repo_root" in
    */aiur-workspaces/*)
      printf '%s\n' "$repo_root"
      return 0
      ;;
  esac

  case "$PWD" in
    */aiur-workspaces/*)
      printf '%s\n' "$PWD"
      return 0
      ;;
  esac

  return 1
}

agent_ir_port() {
  local seed="$1" checksum
  checksum="$(printf '%s' "$seed" | cksum | awk '{print $1}')"
  printf '%s\n' "$((45000 + (checksum % 10000)))"
}

enable_agent_ir_sandbox() {
  local marker="$1"
  local pin_bridge_port="${2:-0}"
  local sandbox_root="${AIUR_AGENT_IR_ROOT:-$marker/.aiur-agent-ir}"
  local logs_parent="$sandbox_root/logs"
  local state_dir="$sandbox_root/state"
  local runtime_dir="$sandbox_root/runtime"
  local config_dir="$sandbox_root/config"
  local bridge_port

  mkdir -p "$logs_parent" "$state_dir" "$runtime_dir" "$config_dir"

  export AIUR_AGENT_IR_SANDBOX=1
  export AIUR_AGENT_IR_ROOT="$sandbox_root"
  export AIUR_AGENT_IR_LOGS_PARENT="$logs_parent"
  export AIUR_BG_STATE_DIR="$state_dir"
  export AIUR_COOKIE_FILE="$state_dir/cookie"
  export AIUR_PROFILES_FILE="$config_dir/aiur.profiles"
  export AIUR_AGENT_IR_XDG_CONFIG_HOME="$config_dir"
  export AIUR_AGENT_IR_XDG_STATE_HOME="$state_dir"
  export XDG_RUNTIME_DIR="$runtime_dir"
  export AIUR_LOGS_ROOT="$logs_parent/$(date -u +%Y%m%dT%H%M%SZ)-$$"

  if [ "$pin_bridge_port" -eq 1 ] && [ -z "${AIUR_OPENCODE_BRIDGE_PORT:-}" ]; then
    bridge_port="$(agent_ir_port "$marker")"
    export AIUR_OPENCODE_BRIDGE_PORT="$bridge_port"
  fi

  echo "🧪 agent IR sandbox: $sandbox_root" >&2
  echo "   workspace marker: $marker" >&2
}

apply_agent_ir_xdg_env() {
  if [ "${AIUR_AGENT_IR_SANDBOX:-}" = "1" ]; then
    export XDG_CONFIG_HOME="${AIUR_AGENT_IR_XDG_CONFIG_HOME:?}"
    export XDG_STATE_HOME="${AIUR_AGENT_IR_XDG_STATE_HOME:?}"
  fi
}

# Internal entry point for the rebuild `aiur restart` runs between its stop and
# its start (the engine invokes it through AIUR_RESTART_BUILD_CMD). It is a
# separate process so it takes the build lock in its own right, and it applies
# the same build-if-stale rule as any other dev launch: a release the sources
# have not outrun is already the latest build, and a forced rebuild of an
# unchanged tree would only lengthen the window where no daemon is running. Use
# `aiurdev build` when you want the unconditional force-rebuild.
#
# It sits ABOVE the tmux guard on purpose. It starts no session, so the guard
# does not apply — and an inherited $TMUX would otherwise make a rebuild that
# never ran look like a failed one, with the daemon already stopped.
if [ "${1:-}" = "__ensure-build" ]; then
  # The fleet is down for the whole of this step, including any wait for a
  # rebuild another shell is holding the lock for. Say so, so a long wait reads
  # as an outage the operator can act on rather than an idle prompt.
  echo "🔁 refreshing the release; the daemon is stopped until this finishes" >&2
  ensure_build_status=0
  ensure_built || ensure_build_status=$?
  if [ "$ensure_build_status" -eq 0 ]; then
    write_restart_receipt
  fi
  exit "$ensure_build_status"
fi

# Refuse a cwd/target mismatch before anything is built, started, or stopped.
# `__ensure-build` above is exempt: it runs with AIUR_REPO_ROOT pinned by the
# parent that already passed this guard, mid-restart with the daemon down, where
# a refusal would only strand the fleet on a decision already made.
guard_checkout_target "$@"

# `aiur upgrade` installs a published npm release. It can never make sense
# under a development launcher, and the acceptance contract is that it changes
# nothing on disk here — so refuse before anything is built, started, or
# touched. The shared engine refuses dev release dirs too; this is the launcher
# check that fires even before a build would be considered (#2109).
if [ "${1:-}" = "upgrade" ]; then
  echo "❌ aiur upgrade cannot run under aiurdev (a development checkout)." >&2
  echo "   aiurdev runs code built from the local tree; aiur upgrade installs a published" >&2
  echo "   npm release and would not touch this working tree. Nothing has been changed." >&2
  echo "   Install aiur from npm and run \`aiur upgrade\` from the installed CLI instead." >&2
  exit 64
fi

# aiur spawns its own tmux on a dedicated socket and does not nest cleanly.
if [ -n "${TMUX:-}" ]; then
  echo "❌ already inside a tmux session (\$TMUX is set)" >&2
  echo "Open a fresh terminal without tmux and try again." >&2
  exit 1
fi

# `aiurdev build` force-rebuilds; otherwise rebuild only when stale.
if [ "${1:-}" = "build" ]; then
  acquire_build_lock
  trap 'release_build_lock' EXIT INT TERM
  build_status=0
  if [ "${2:-}" = "--deps" ]; then
    echo "🔨 clean force-rebuild incl. deps (wiping _build/dev)" >&2
    rm -rf "$elixir_dir/_build/dev"
    ensure_elixir_deps || build_status=$?
  else
    echo "🔨 force-rebuild aiur app + release (keeping dep artifacts)" >&2
    rm -rf "$elixir_dir/_build/dev/rel"
    ensure_elixir_deps || build_status=$?
    require_mise || build_status=$?
  fi
  if [ "$build_status" -eq 0 ]; then
    build_aiur || build_status=$?
  fi
  release_build_lock
  trap - EXIT INT TERM
  exit "$build_status"
fi

# --- dev test/debug harness (dev-only; never lives in the shared engine) -------
# These flags don't exist in the product CLI. The shim consumes them, turns them
# into a GitHub sandbox reset + AIUR_DEBUG, then hands the rest to the engine for
# a normal foreground run.
#
#   --test    reset the single sandbox ticket (issue 99) then launch
#   --test3   reset the 3-ticket blocker chain (drives the remote agent) then launch
#   --debug   verbose logging (AIUR_DEBUG=1)
#   --clear   delete prior ~/.aiur/logs sessions first (requires --debug)
debug_mode=0
clear_mode=0
test_single=0
test3_mode=0
allow_remote=0
has_port=0
expect_port_value=0
passthrough=()
for arg in "$@"; do
  if [ "$expect_port_value" -eq 1 ]; then
    passthrough+=("$arg")
    expect_port_value=0
    continue
  fi

  case "$arg" in
    --debug) debug_mode=1 ;;
    --clear) clear_mode=1 ;;
    --allow-remote) allow_remote=1 ;;
    --force) passthrough+=("$arg") ;; # forward to the engine (e.g. `init --force`)
    --port) has_port=1; passthrough+=("$arg"); expect_port_value=1 ;;
    --port=*) has_port=1; passthrough+=("$arg") ;;
    --test) test_single=1 debug_mode=1 clear_mode=1 ;;
    --test3) test3_mode=1 debug_mode=1 clear_mode=1 allow_remote=1 ;;
    *) passthrough+=("$arg") ;;
  esac
done

if [ "$expect_port_value" -eq 1 ]; then
  echo "❌ --port requires a value (e.g. --port 0 or --port=4000)" >&2
  exit 64
fi

if [ "$clear_mode" -eq 1 ] && [ "$debug_mode" -ne 1 ]; then
  echo "❌ --clear requires --debug (e.g. aiurdev --debug --clear)" >&2
  exit 64
fi

agent_workspace_marker=""
if marker="$(in_agent_workspace_tree)"; then
  agent_workspace_marker="$marker"
fi

if [ -n "$agent_workspace_marker" ] && { [ "$test_single" -eq 1 ] || [ "$test3_mode" -eq 1 ]; }; then
  echo "❌ manual --test runs are blocked inside agent workspaces" >&2
  echo "   workspace marker: $agent_workspace_marker" >&2
  echo "   This path resets pinned GitHub sandbox tickets and can mutate the live dogfood backlog." >&2
  echo "   Agents must stop here: do not retry from a copied /tmp harness, clone, or alternate checkout." >&2
  echo "   Executor-root manual test runs remain allowed outside agent turns." >&2
  exit 64
fi

if [ -n "$agent_workspace_marker" ]; then
  enable_agent_ir_sandbox "$agent_workspace_marker" 0
fi

if builds_after_stop "${passthrough[0]:-}"; then
  # Normally a no-op: a complete release is already there and the real rebuild
  # waits until the daemon is down. When there is no complete release, the stop
  # itself cannot run without one, so the repair build necessarily lands before
  # the stop — announce that inversion instead of performing it silently.
  release_ready || echo "⚠️  no complete release; building one BEFORE the stop (this rewrites the release the running daemon booted from)" >&2
  ensure_control_surface
elif pure_control_command "${passthrough[0]:-}" || [ "$checkout_diverges" -eq 1 ]; then
  # The divergent case reaches here only for commands the guard let through, and
  # those must not rebuild a checkout the operator is not standing in. Reusing
  # the complete release is exactly what a control command needs anyway.
  ensure_control_surface
else
  ensure_built
fi

[ "$debug_mode" -eq 1 ] && export AIUR_DEBUG=1
if [ "$clear_mode" -eq 1 ]; then
  if [ -n "${AIUR_AGENT_IR_LOGS_PARENT:-}" ]; then
    rm -rf "$AIUR_AGENT_IR_LOGS_PARENT/"* 2>/dev/null || true
  else
    rm -rf "$HOME/.aiur/logs/"* 2>/dev/null || true
  fi
fi

if [ "$test_single" -eq 1 ] || [ "$test3_mode" -eq 1 ]; then
  reset_cmd=(mix aiur.test.reset)
  require_mise || exit 64
  echo "🛑 stopping any running aiur" >&2
  "$engine" stop >/dev/null 2>&1 || true

  reset_args=("--confirm" "--force")
  [ "$test_single" -eq 1 ] && reset_args+=("--single")
  [ "$allow_remote" -eq 1 ] && reset_args+=("--allow-remote")
  if [ "${AIUR_AGENT_IR_SANDBOX:-}" = "1" ]; then
    reset_cmd=(env "XDG_CONFIG_HOME=${AIUR_AGENT_IR_XDG_CONFIG_HOME:?}" "XDG_STATE_HOME=${AIUR_AGENT_IR_XDG_STATE_HOME:?}" "${reset_cmd[@]}")
  fi
  if ! (cd "$elixir_dir" && "$mise_bin" exec -- "${reset_cmd[@]}" "${reset_args[@]}"); then
    echo "❌ test reset failed; refusing to launch. Inspect the output above." >&2
    exit 1
  fi

  # GitHub's label index is eventually consistent — wait until the pinned
  # tickets show under agent:todo (or fall through after 30s) so the
  # orchestrator's first poll doesn't miss a freshly-labelled ticket.
  tickets_file="$repo_root/.aiur-test-tickets.json"
  expected=0
  if command -v jq >/dev/null 2>&1 && [ -r "$tickets_file" ]; then
    if [ "$test_single" -eq 1 ]; then
      expected=1
    else
      expected="$(jq -r '.tickets | length' "$tickets_file" 2>/dev/null || echo 0)"
    fi
  fi
  if [ "$expected" -gt 0 ]; then
    echo "⏳ settling GitHub label index" >&2
    deadline=$((SECONDS + 30))
    while [ "$SECONDS" -lt "$deadline" ]; do
      actual="$(gh issue list --label agent:todo --json number 2>/dev/null | jq -r 'length' 2>/dev/null || echo 0)"
      [ "$actual" -ge "$expected" ] && break
      sleep 1
    done
  fi
fi

# --test3 wall-clock timer: a detached poller that appends a JSON line to
# .aiur-test3-runs.jsonl when all 3 tickets reach agent:human-review (or 90m).
if [ "$test3_mode" -eq 1 ]; then
  pid_file="$repo_root/.aiur-test3-timer.pid"
  if [ -r "$pid_file" ]; then
    prior_pid="$(cat "$pid_file" 2>/dev/null || true)"
    { [ -n "$prior_pid" ] && kill -0 "$prior_pid" 2>/dev/null && kill "$prior_pid" 2>/dev/null; } || true
    rm -f "$pid_file"
  fi
  timer="$repo_root/scripts/aiur-test3-timer"
  if [ -x "$timer" ]; then
    echo "⏱  test3 timer started (results append to .aiur-test3-runs.jsonl)" >&2
    setsid "$timer" "$repo_root" "$(date +%s)" </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
fi

export AIUR_RELEASE_DIR="$release_dir"

# The dev half of `aiur restart`: the engine owns the stop/build/start ordering,
# this shim owns what "build" means here. %q keeps a repo path with spaces intact
# through the engine's `bash -c`. Exported only for the command that consumes it,
# so no daemon or agent process inherits a rebuild bound to this checkout.
#
# AIUR_REPO_ROOT is pinned into the command rather than left to the child's own
# path resolution: the target was settled here, and re-deriving it in a process
# the engine launches from the operator's cwd is the very ambiguity this restart
# is supposed to have eliminated by the time it stops the daemon.
#
# AIUR_SKIP_BUILD excludes it entirely rather than wiring in a rebuild that will
# decline to build: the engine would stop the daemon, get a success it cannot
# match to the release on disk, and refuse to start. Skipping the build means
# `restart` is a plain bounce, which is what asking to skip the build asks for.
if builds_after_stop "${passthrough[0]:-}" && [ "${AIUR_SKIP_BUILD:-0}" != "1" ]; then
  printf -v AIUR_RESTART_BUILD_CMD 'AIUR_REPO_ROOT=%q %q %q' \
    "$repo_root" "$script_dir/$(basename "$src")" "__ensure-build"
  # Declares that this builder reports a verifiable receipt, so the engine can
  # tell "unverified" apart from "verified and wrong" for a builder it does not
  # own.
  export AIUR_RESTART_BUILD_CMD AIUR_RESTART_BUILD_VERIFIES=1
fi

if requires_pinned_opencode "${passthrough[0]:-}"; then
  ensure_pinned_opencode || exit 64
fi

# ── Processor optimization: cap schedulers on agent-spawned Elixir BEAMs ──
# Every agent pre-PR gate command (`mix compile`, `mix test`, `mix credo`)
# launches its OWN BEAM, and a BEAM defaults to one scheduler thread per
# logical core. Run many agents at once and the scheduler threads multiply
# far past the core count, oversubscribing the CPU (high run-queue, ~0% idle,
# thrash) — the daemon and every agent then fight for the same cores.
#
# ELIXIR_ERL_OPTIONS is read by the `elixir`/`mix`/`iex` launcher (NOT the
# release boot script), and codex runs with shell_environment_policy.inherit=all,
# so this caps ONLY the agents' mix BEAMs — the daemon release keeps its full
# scheduler set and full coordination throughput.
#
# `+S N:N` sets N schedulers (+ N online). Rule of thumb: ~cores / 3.
#   host cores -> cap:    6 -> +S 2:2     12 -> +S 4:4     24 -> +S 8:8
#   Worked example (12-core host, 12 agents):
#     default : 12 agents x 12 schedulers = 144 threads  (~12x oversub;
#               run-queue ~120, idle 0%, 1-min load ~73)
#     +S 4:4  : 12 agents x  4 schedulers =  48 threads  (~4x; load ~7)
# Lower N packs more agents but slows each individual compile; higher N is
# faster per compile but trends back toward saturation.
[ -n "${AIUR_AGENT_MIX_SCHEDULERS:-}" ] && export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} +S ${AIUR_AGENT_MIX_SCHEDULERS}:${AIUR_AGENT_MIX_SCHEDULERS}"

apply_agent_ir_xdg_env
if [ "${#passthrough[@]}" -gt 0 ]; then
  if pure_control_command "${passthrough[0]}"; then
    control_retry_signal="$(mktemp "${TMPDIR:-/tmp}/aiurdev-control-retry.XXXXXX")"
    rm -f "$control_retry_signal"
    export AIUR_CONTROL_RELEASE_RETRYABLE=1
    export AIUR_CONTROL_RELEASE_RETRY_SIGNAL="$control_retry_signal"
    set +e
    "$engine" "${passthrough[@]}"
    control_status=$?
    set -e

    if [ "$control_status" -eq 75 ] && [ -f "$control_retry_signal" ]; then
      # The shared engine reserves EX_TEMPFAIL plus this per-invocation signal
      # for a dev release that became incomplete before its RPC launcher exec.
      rm -f "$control_retry_signal"
      echo "⏳ dev release changed during control command; waiting for rebuild and retrying" >&2
      acquire_build_lock
      trap 'release_build_lock' EXIT INT TERM
      if ! release_ready; then
        ensure_built_locked
      fi
      release_build_lock
      trap - EXIT INT TERM
      export AIUR_CONTROL_RELEASE_RETRYABLE=0
      exec "$engine" "${passthrough[@]}"
    fi

    rm -f "$control_retry_signal"
    exit "$control_status"
  fi
  exec "$engine" "${passthrough[@]}"
else
  exec "$engine"
fi
