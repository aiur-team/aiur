#!/usr/bin/env bash
#
# aiurdev — dev shim for the aiur launcher engine.
#
# Runs the SAME engine the installed `aiur` runs, but against this repo's local
# `mix release` (rebuilding it when stale) instead of an npm-installed platform
# package. It shares the installed `aiur` distribution identity; the only
# difference is which release runs (AIUR_RELEASE_DIR). Every subcommand lives in
# packaging/npm/aiur-cli/libexec/aiur-engine.sh — this file owns only the
# repo-local release resolution and the dev build-if-stale step.
set -euo pipefail

# Resolve the repo root, following a symlink (e.g. ~/.local/bin/aiurdev -> here)
# so script_dir is the real scripts/ dir, not the symlink's parent.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
script_dir="$(cd -P "$(dirname "$src")" && pwd)"
repo_root="${AIUR_REPO_ROOT:-$(cd "$script_dir/.." && pwd)}"
elixir_dir="$repo_root/src"
release_dir="$elixir_dir/_build/dev/rel/aiur"
engine="$repo_root/packaging/npm/aiur-cli/libexec/aiur-engine.sh"
mise_bin="${AIUR_MISE_BIN:-$(command -v mise 2>/dev/null || true)}"

require_mise() {
  if [ -z "$mise_bin" ] || [ ! -x "$mise_bin" ]; then
    echo "❌ mise not found on PATH. Install mise (https://mise.jdx.dev) or set AIUR_MISE_BIN." >&2
    exit 64
  fi
}

elixir_deps_ready() {
  local deps_dir="$elixir_dir/deps" dep
  [ -d "$elixir_dir/_build" ] && [ -d "$deps_dir" ] || return 1
  [ -f "$elixir_dir/mix.lock" ] || return 0
  while IFS= read -r dep; do
    [ -n "$dep" ] && [ ! -d "$deps_dir/$dep" ] && return 1
  done < <(sed -n 's/^  "\([^"]*\)":.*/\1/p' "$elixir_dir/mix.lock")
  return 0
}

ensure_elixir_deps() {
  if ! elixir_deps_ready; then
    require_mise
    echo "🔨 fetching and compiling Hex dependencies" >&2
    (cd "$elixir_dir" && "$mise_bin" exec -- mix deps.get && "$mise_bin" exec -- mix compile) >&2
  fi
}

build_aiur() {
  require_mise
  echo "🔨 rebuilding bin/aiur (release)" >&2
  (cd "$elixir_dir" && "$mise_bin" exec -- mix release --overwrite) 2>&1 |
    grep -v -E "^(\* assembling|\* skipping runtime|Generated aiur app|Release created at|    _build|    # |Once the release is running:|To list all commands:|$)" >&2 ||
    true
}

# Rebuild the release when the shim/release is missing or any source is newer.
ensure_built() {
  [ "${AIUR_SKIP_BUILD:-0}" = "1" ] && return 0
  ensure_elixir_deps

  if [ ! -x "$elixir_dir/bin/aiur" ] || [ ! -x "$release_dir/bin/aiur" ]; then
    build_aiur
    return
  fi

  if [ -n "$(find "$elixir_dir/lib" "$elixir_dir/mix.exs" "$elixir_dir/mix.lock" \
    -newer "$elixir_dir/bin/aiur" -print -quit 2>/dev/null)" ]; then
    build_aiur
  fi
}

# aiur spawns its own tmux on a dedicated socket and does not nest cleanly.
if [ -n "${TMUX:-}" ]; then
  echo "❌ already inside a tmux session (\$TMUX is set)" >&2
  echo "Open a fresh terminal without tmux and try again." >&2
  exit 1
fi

# `aiurdev build` force-rebuilds; otherwise rebuild only when stale.
if [ "${1:-}" = "build" ]; then
  if [ "${2:-}" = "--deps" ]; then
    echo "🔨 clean force-rebuild incl. deps (wiping _build/dev)" >&2
    rm -rf "$elixir_dir/_build/dev"
  else
    echo "🔨 force-rebuild aiur app + release (keeping dep artifacts)" >&2
    rm -rf "$elixir_dir/_build/dev/rel"
    require_mise
    (cd "$elixir_dir" && "$mise_bin" exec -- mix compile --force) >&2
  fi
  ensure_elixir_deps
  build_aiur
  exit 0
fi

ensure_built

export AIUR_RELEASE_DIR="$release_dir"
exec "$engine" "$@"
