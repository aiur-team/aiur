#!/usr/bin/env bash
# Reviewer worktrees use the same lease protocol and host settings as agents.
set -euo pipefail

if (($# == 0)); then
  printf 'Usage: scripts/build-gate <command> [args...]\n' >&2
  exit 64
fi

: "${AIUR_BUILD_GATE_DIR:?Set the running fleet build-gate directory}"
: "${AIUR_BUILD_GATE_SLOTS:?Set the running fleet build-gate capacity}"
export AIUR_BUILD_GATE_DIR AIUR_BUILD_GATE_SLOTS
export AIUR_BUILD_GATE_LOCK_DIR="${AIUR_BUILD_GATE_LOCK_DIR:-$AIUR_BUILD_GATE_DIR.locks}"
export BASH_ENV="$(dirname "$(realpath "$0")")/../src/priv/build_gate.bash"
unset AIUR_BUILD_GATE_HOOK_LOADED
source "$BASH_ENV"
aiur_build_gate_run_or_reuse review "$@"
