#!/usr/bin/env bash
# The npm release is pending; consume the Executor-approved immutable Git pin.
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
commit=${1:?Usage: scripts/vendor-listener-spec <khala-commit-sha>}
[[ $# == 1 && $commit =~ ^[0-9a-f]{40}$ ]] || { echo 'Expected a full commit SHA' >&2; exit 1; }
stage=$(mktemp -d "${TMPDIR:-/tmp}/listener-spec.XXXXXX")
trap 'rm -rf -- "$stage"' EXIT
gh api "repos/aiur-team/khala/tarball/$commit" > "$stage/source.tar.gz"
prefix=$(tar -tzf "$stage/source.tar.gz" | sed -n '1p')
mkdir "$stage/spec"
tar -xzf "$stage/source.tar.gz" -C "$stage/spec" --strip-components=4 "${prefix}packages/listener/spec/v1"
python3 - "$stage/spec" "$commit" <<'PY'
import hashlib
from pathlib import Path
import sys
root = Path(sys.argv[1])
lines = ['# source aiur-team/khala', '# git_commit ' + sys.argv[2]]
for path in sorted(root.rglob('*')):
    if path.is_symlink():
        raise SystemExit('Refusing symlink in spec')
    if path.is_file():
        lines.append(hashlib.sha256(path.read_bytes()).hexdigest() + '  ' + path.relative_to(root).as_posix())
(root / 'CHECKSUM').write_text('\n'.join(lines) + '\n')
PY
python3 "$root/scripts/check-listener-spec.py" "$stage/spec"
destination="$root/src/priv/listener_spec"
# All network, extraction and validation failures leave the committed tree alone.
if [[ -e $destination ]]; then mv -- "$destination" "$stage/previous"; fi
if ! mv -- "$stage/spec" "$destination"; then
  if [[ -e $stage/previous ]]; then mv -- "$stage/previous" "$destination"; fi
  exit 1
fi
