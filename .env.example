# Aiur environment variables. Generated from the env schema — do not edit by hand; run `mix aiur.env.example`.

## Required
# Fallback GitHub credential; ignored when the GitHub App vars below are set.
GITHUB_TOKEN=                   # github.com/settings/tokens -> Generate -> repo scope
# Alternative GitHub credential name the guard reads when GITHUB_TOKEN is unset; never required.
GH_TOKEN=                       # same token as GITHUB_TOKEN, exported under gh's preferred name

## Optional - GitHub App auth. Gives the daemon its own rate-limit budget and a bot identity.
# GitHub App numeric id; preferred auth, short-lived installation tokens.
GITHUB_APP_ID=                  # App settings page, top of page
# Which installation of the App to authenticate as.
GITHUB_APP_INSTALLATION_ID=     # Install App -> number at end of URL
# Path to the App private key PEM; keeps the key out of the env.
GITHUB_APP_PRIVATE_KEY_PATH=    # App settings -> Generate a private key -> save, chmod 600
# Inline PEM alternative to the path above; set one, not both.
GITHUB_APP_PRIVATE_KEY=

## Optional - Webhooks. Cuts API polling; needs a public URL reaching this daemon.
# Secret GitHub signs webhook deliveries with; unset rejects every delivery.
AIUR_GITHUB_WEBHOOK_SECRET=     # openssl rand -hex 32 -> paste into repo webhook

## Optional - Linear tracker. Use Linear instead of GitHub as the issue tracker.
# Linear API key when the tracker is Linear.
LINEAR_API_KEY=                 # linear.app/settings/api -> personal API key
# Assignee Linear issues are assigned to by default.
LINEAR_ASSIGNEE=

## Optional - Voice. Mic input and spoken replies on dashboard and Stream Deck.
# Speech-to-text for dashboard and Stream Deck mics.
ELEVENLABS_API_KEY=             # elevenlabs.io -> Profile -> API Keys

## Optional - Aiur dashboard. Web UI at :4000; CLI and TUI work without it.
# Dashboard Basic Auth user; both credentials together.
AIUR_DASHBOARD_USERNAME=        # see guide/gui
# Dashboard Basic Auth password; unset makes the dashboard refuse all requests.
AIUR_DASHBOARD_PASSWORD=        # see guide/gui
# Google OAuth client id for dashboard browser sign-in; pair with the client secret.
AIUR_GOOGLE_CLIENT_ID=          # Google Cloud -> OAuth client
# Google OAuth client secret for dashboard browser sign-in.
AIUR_GOOGLE_CLIENT_SECRET=      # Google Cloud -> OAuth client
# Optional persistent dashboard signing key; otherwise Aiur stores one per instance.
AIUR_SECRET_KEY_BASE=           # openssl rand -base64 48

## Optional - Supervisor Decision API. Dedicated bearer credential for Executor automation.
# Bearer-safe token (at least 32 bytes) for the Supervisor Decision API; generate one with `openssl rand -base64 32`; unset or empty disables it.
AIUR_SUPERVISOR_TOKEN=
# Operator token for startup CI readiness inspection and `aiur init`.
AIUR_CI_READINESS_TOKEN=

## Optional - Shared PostgreSQL instance coordination for multi-instance dispatch.
# PostgreSQL URL shared by instances; enables atomic ticket leases and live-instance heartbeats.
AIUR_LEASE_DATABASE_URL=        # configure a TLS PostgreSQL connection URL

## Optional - Provider API keys. Named by agent.backend_configs.<backend>.api_key_env.
# DeepSeek backend key; used when a backend config names this env var.
DEEPSEEK_API_KEY=               # platform.deepseek.com -> API Keys
# Moonshot backend key; used when a backend config names this env var.
MOONSHOT_API_KEY=
# OpenRouter backend key; used when a backend config names this env var.
OPENROUTER_API_KEY=             # openrouter.ai -> Keys -> Create key
# OpenRouter usage-management key; used when a backend config names this env var.
OPENROUTER_MANAGEMENT_KEY=
# Netlify read-only usage API credential; never logged or sent to agents.
NETLIFY_AUTH_TOKEN=
# Claude Code subscription token for an operator deployment; pass only to Claude workers and never configure on a consumer instance.
CLAUDE_CODE_OAUTH_TOKEN=
# Anthropic API key for Claude API billing; consumer deployments require this instead of subscription auth.
ANTHROPIC_API_KEY=
# OpenAI API key for Codex API billing or a consumer deployment.
OPENAI_API_KEY=

## Runtime - launcher-managed. Normally set by `aiur` itself, not by hand.
# Disable dotenv files so hosted secrets must be supplied by the daemon environment.
AIUR_SECRETS_FROM_ENV=
# Explicitly allow GITHUB_TOKEN instead of a GitHub App in hosted/container mode.
AIUR_GITHUB_ALLOW_PAT=
# Directory for cookie, state and per-instance files.
AIUR_BG_STATE_DIR=
# Persistent Codex credential directory; hosted Aiur sets this under AIUR_BG_STATE_DIR.
CODEX_HOME=
# Declare that the hosted state directory survives daemon restarts; otherwise env-only mode requires AIUR_SECRET_KEY_BASE.
AIUR_STATE_PERSISTENT=
# Directory for daemon logs.
AIUR_LOGS_ROOT=
# tmux session name the launcher uses.
AIUR_TMUX_SESSION=
# tmux socket name the launcher uses.
AIUR_TMUX_SOCKET=
# BEAM distribution cookie; container launches use this or AIUR_COOKIE_FILE and fail if neither exists, while other launches generate one if unset.
AIUR_ERLANG_COOKIE=             # openssl rand -hex 32

## Development and debugging.
# Enable debug logging (1 / true / yes).
AIUR_DEBUG=
# Disable opencode pre-warm (1 / true / yes).
AIUR_PREWARM_DISABLED=
# Timeout (ms) for the `gh auth token` keyring lookup; raise it for a slow-but-succeeding keyring unlock.
AIUR_GH_KEYRING_TIMEOUT_MS=
# opencode-serve bridge port; picked automatically when unset.
AIUR_OPENCODE_BRIDGE_PORT=
# Custom ssh config path used for git operations.
AIUR_SSH_CONFIG=
# Default dashboard bind host when server.host is unset.
AIUR_DEFAULT_DASHBOARD_HOST=
# Authoritative integration branch for PRs and affected-test scoping.
AIUR_BASE_BRANCH=
# Pins the executor wake-stream owner when multiple daemons share a repository.
AIUR_EXECUTOR_ID=
