# aiur reads secrets from this file. Copy to .env and fill in values.
# Keep .env out of version control (it is gitignored).
#
# GitHub personal access token (repo scope). Create one at:
#   https://github.com/settings/tokens
#
# This is the FALLBACK credential. When GitHub App credentials are configured
# below, the daemon authenticates with a short-lived GitHub App installation
# token instead and GITHUB_TOKEN is ignored.
GITHUB_TOKEN=

# GitHub App credentials for short-lived installation-token authentication
# (preferred over GITHUB_TOKEN; see docs/security/daemon-token-posture.md).
# Create the App, install it on the target repository, and set:
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Private key PEM. Prefer a key FILE over the inline value so the key never
# appears in the process environment:
GITHUB_APP_PRIVATE_KEY_PATH=
# Inline PEM alternative to the key path above (use one or the other):
GITHUB_APP_PRIVATE_KEY=

# Shared secret for GitHub webhook deliveries, verified as an HMAC-SHA256 over
# the raw request body. Generate at least 32 random bytes with a CSPRNG
# (`openssl rand -hex 32`); do NOT reuse GITHUB_TOKEN or an App private key,
# and set the same value on the GitHub webhook. Public ingress setup is in
# docs/security/webhook-ingress.md. With this unset the receiver rejects every
# delivery rather than accepting unsigned ones.
AIUR_GITHUB_WEBHOOK_SECRET=

# Dedicated OCC supervisor API bearer token. Generate at least 32 random
# bearer-safe bytes; do not reuse dashboard Basic Auth or commit the value.
AIUR_SUPERVISOR_TOKEN=
