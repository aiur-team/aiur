{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aiur component ownership manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "components"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "directory_published": {
      "type": "boolean"
    },
    "seams": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "ports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "layer",
        "kind",
        "paths",
        "facades",
        "facade_pending",
        "requires",
        "optional",
        "owns",
        "prior"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "kind": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "facades": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "facade_pending": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prior": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "private_namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "owns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config",
            "env",
            "state",
            "capabilities"
          ],
          "properties": {
            "config": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "uniqueItems": true
            },
            "env": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "uniqueItems": true
            },
            "state": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*(?:_dir|_path)$"
              },
              "uniqueItems": true
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "install": {
          "type": "object"
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "feature_id": {
          "type": "string"
        },
        "shared_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "forbid": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/modulePattern"
          }
        }
      },
      "if": {
        "properties": {
          "facades": {
            "contains": {
              "const": "*"
            }
          }
        }
      },
      "then": {
        "properties": {
          "facade_pending": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "modulePattern": {
      "type": "string",
      "pattern": "^(?:Aiur|AiurWeb)(?:\\.[A-Z][A-Za-z0-9_]*)*(?:\\.\\*)?$"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to_module",
        "kind",
        "reason"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "to_module": {
          "$ref": "#/$defs/modulePattern"
        },
        "kind": {
          "enum": [
            "reference",
            "behaviour"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "only_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
