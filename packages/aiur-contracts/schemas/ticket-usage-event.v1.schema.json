{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/ticket-usage-event.v1.schema.json",
  "title": "TicketUsageChangedEvent",
  "allOf": [
    { "$ref": "outbound-event-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "topic": { "type": "string", "pattern": "^ticket\\.[A-Za-z0-9._:-]+\\.usage\\.changed$" },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ticket": { "type": "string", "minLength": 1 },
            "job_id": { "type": ["string", "null"] }
          },
          "required": ["ticket", "job_id"]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position": { "type": "integer", "minimum": 1 },
            "generation": { "type": "integer", "minimum": 1 }
          },
          "required": ["position", "generation"]
        }
      },
      "required": ["topic", "refs", "attrs"]
    }
  ]
}
