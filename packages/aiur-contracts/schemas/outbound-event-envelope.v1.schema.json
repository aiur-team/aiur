{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/outbound-event-envelope.v1.schema.json",
  "title": "OutboundEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "instance": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "id": { "type": "integer", "minimum": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "class": { "enum": ["ephemeral", "live", "ledgered", "logged", "journaled"] },
    "occurred_at": { "type": ["string", "null"], "format": "date-time" },
    "observed_at": { "type": ["string", "null"], "format": "date-time" },
    "source": { "enum": ["agent", "agent_alert", "alert", "executor", "legacy", "unknown"] },
    "refs": { "type": "object" },
    "attrs": { "type": "object" },
    "payload_version": { "type": "integer", "minimum": 1 },
    "anchor": { "type": "null" }
  },
  "required": [
    "v",
    "instance",
    "seq",
    "id",
    "topic",
    "class",
    "occurred_at",
    "observed_at",
    "source",
    "refs",
    "attrs",
    "payload_version",
    "anchor"
  ]
}
