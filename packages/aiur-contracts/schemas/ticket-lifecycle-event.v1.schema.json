{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/ticket-lifecycle-event.v1.schema.json",
  "title": "TicketLifecycleChangedEvent",
  "allOf": [
    { "$ref": "outbound-event-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "topic": { "type": "string", "pattern": "^ticket\\.[A-Za-z0-9._:-]+\\.lifecycle\\.changed$" },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ticket": { "type": "string", "minLength": 1 },
            "job_id": { "type": ["string", "null"] }
          },
          "required": ["ticket", "job_id"]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lifecycle": {
              "enum": ["queued", "retrying", "allocated", "running", "paused", "waiting", "replaced", "completed", "cancelled"]
            },
            "lifecycle_source": { "enum": ["status_report", "tracker"] }
          },
          "required": ["lifecycle", "lifecycle_source"]
        }
      },
      "required": ["topic", "refs", "attrs"]
    }
  ]
}
