{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/ticket-spend-cap-reached-event.v1.schema.json",
  "title": "TicketSpendCapReachedEvent",
  "allOf": [
    { "$ref": "outbound-event-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "topic": { "type": "string", "pattern": "^ticket\\.[A-Za-z0-9._:-]+\\.usage\\.spend_cap_reached$" },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ticket": { "type": "string", "minLength": 1 },
            "job_id": { "type": ["string", "null"] }
          },
          "required": ["ticket", "job_id"]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spend_cap_state": { "const": "budget_exhausted" },
            "currency": { "const": "USD" }
          },
          "required": ["spend_cap_state", "currency"]
        }
      },
      "required": ["topic", "refs", "attrs"]
    }
  ]
}
