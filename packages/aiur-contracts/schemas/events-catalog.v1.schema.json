{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/events-catalog.v1.schema.json",
  "title": "EventsCatalog",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "v": {
      "const": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "title": "ExportedTopic",
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "ephemeral",
              "live",
              "ledgered",
              "logged",
              "journaled"
            ]
          },
          "payload_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "pattern",
          "class",
          "payload_version"
        ]
      }
    }
  },
  "required": [
    "v",
    "topics"
  ]
}
