{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/ticket-cancel-result-event.v1.schema.json",
  "title": "TicketCancelResultEvent",
  "allOf": [
    { "$ref": "outbound-event-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "topic": { "type": "string", "pattern": "^ticket\\.[A-Za-z0-9._:-]+\\.cancel\\.result$" },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ticket": { "type": "string", "minLength": 1 },
            "job_id": { "type": ["string", "null"] }
          },
          "required": ["ticket", "job_id"]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tracker_state": { "const": "cancelled" },
            "process_status": { "enum": ["exited", "still_running", "kill_failed", "generation_changed"] }
          },
          "required": ["tracker_state", "process_status"]
        }
      },
      "required": ["topic", "refs", "attrs"]
    }
  ]
}
