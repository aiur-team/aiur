{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/command.v2.schema.json",
  "title": "CommandV2",
  "description": "Additive read-API Command projection. Legacy rows have no payload_version; routing facts are separate from frozen request snapshots.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "question": {
      "type": "string"
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "worker",
            "executor"
          ]
        },
        "ticket": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "executor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "origin": {
      "enum": [
        "emit_event",
        "attention",
        "native_question",
        "executor_cli",
        "supervisor_api"
      ]
    },
    "native": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "harness": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "hold": {
          "enum": [
            "in_band",
            "deferred",
            "released"
          ]
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "harness",
        "hold"
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandMedia"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandOption"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "short_label": {
      "type": [
        "string",
        "null"
      ],
      "description": "At most 40 Unicode graphemes, matching the Command content validator."
    },
    "tags": {
      "type": "array",
      "description": "At most 8 caller-supplied slugs from decision.requested, such as group:<id> or source:<name>. A group: tag joins sibling Commands on one ticket.",
      "items": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^[a-z0-9][a-z0-9_-]{0,31}(:[a-z0-9][a-z0-9._-]*)?$"
      }
    },
    "payload_version": {
      "const": 2
    },
    "route_policy": {
      "enum": [
        "executor_first",
        "simultaneous",
        "human_only",
        null
      ]
    },
    "route_state": {
      "enum": [
        "with_executor",
        "with_both",
        "with_human",
        null
      ]
    },
    "routed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_visible_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "executor_acknowledged_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cause": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "decision_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "cause",
          "at",
          "detail",
          "decision_version"
        ]
      }
    }
  },
  "required": [
    "decision_id",
    "version",
    "question",
    "requester",
    "origin",
    "native",
    "questions",
    "short_label"
  ],
  "$defs": {
    "commandMedia": {
      "type": "object",
      "additionalProperties": false,
      "description": "Typed media on a Command prompt, option or answer. A local file is an attachment reference; a filesystem path is never projected.",
      "properties": {
        "kind": {
          "enum": [
            "image",
            "animated_image",
            "video",
            "audio",
            "embed"
          ]
        },
        "mime_type": {
          "type": "string",
          "description": "MIME type allowlisted for the media kind."
        },
        "attachment_id": {
          "type": "string",
          "pattern": "^med_[0-9a-f]{24}$",
          "description": "Stable, opaque identity for an attachment locator."
        },
        "locator": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "url"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "attachment"
                },
                "attachment_id": {
                  "type": "string",
                  "pattern": "^med_[0-9a-f]{24}$"
                }
              },
              "required": [
                "kind",
                "attachment_id"
              ]
            }
          ]
        },
        "poster": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "url"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "attachment"
                },
                "attachment_id": {
                  "type": "string",
                  "pattern": "^med_[0-9a-f]{24}$"
                }
              },
              "required": [
                "kind",
                "attachment_id"
              ]
            }
          ]
        },
        "alt_text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400,
          "description": "Required as accessible text for image, animated_image and embed items; a client that cannot frame an embed shows it with a link."
        },
        "caption": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "byte_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "mime_type",
        "attachment_id",
        "locator"
      ]
    },
    "commandOption": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "benefits": {
          "type": [
            "string",
            "null"
          ]
        },
        "drawbacks": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "type": [
            "string",
            "null"
          ]
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandMedia"
          }
        }
      },
      "required": [
        "id",
        "label"
      ]
    }
  }
}
