{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/ticket-spend-cap.v1.schema.json",
  "title": "TicketSpendCap",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "contract": { "const": "aiur.ticket_spend_cap" },
    "contract_version": { "const": 1 },
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "ticket": { "$ref": "#/$defs/ticket" },
    "currency": { "const": "USD" },
    "cap_amount": { "$ref": "#/$defs/amount" },
    "spent_amount": { "oneOf": [{ "$ref": "#/$defs/amount" }, { "type": "null" }] },
    "remaining_amount": { "oneOf": [{ "$ref": "#/$defs/amount" }, { "type": "null" }] },
    "state": { "enum": ["active", "unavailable", "budget_exhausted"] },
    "end_state": { "enum": [null, "budget_exhausted"] },
    "coverage": { "$ref": "#/$defs/coverage" },
    "authority": { "type": "object", "additionalProperties": true },
    "configured_at": { "type": "string" },
    "reached_at": { "type": ["string", "null"] },
    "effects": { "$ref": "#/$defs/effects" }
  },
  "required": [
    "contract",
    "contract_version",
    "schema_version",
    "job_id",
    "ticket",
    "currency",
    "cap_amount",
    "spent_amount",
    "remaining_amount",
    "state",
    "end_state",
    "coverage",
    "authority",
    "configured_at",
    "reached_at",
    "effects"
  ],
  "$defs": {
    "amount": {
      "title": "TicketSpendCapAmount",
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$"
    },
    "ticket": {
      "title": "TicketSpendCapIdentity",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "identifier": { "type": "string", "minLength": 1 }
      },
      "required": ["owner", "repository", "identifier"]
    },
    "coverage": {
      "title": "TicketSpendCapCoverage",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": { "enum": ["known", "partial", "unknown", "none"] },
        "known": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "effectState": { "enum": ["not_applicable", "pending", "completed"] },
    "effects": {
      "title": "TicketSpendCapEffects",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop": { "$ref": "#/$defs/effectState" },
        "event": { "$ref": "#/$defs/effectState" },
        "tracker_transition": { "$ref": "#/$defs/effectState" }
      },
      "required": ["stop", "event", "tracker_transition"]
    }
  }
}
