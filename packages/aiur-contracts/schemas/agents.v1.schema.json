{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/agents.v1.schema.json",
  "title": "AgentsStatus",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "contract": {
      "const": "aiur.agents"
    },
    "contract_version": {
      "const": 1
    },
    "running": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runningAgent"
      }
    }
  },
  "required": [
    "contract",
    "contract_version",
    "running"
  ],
  "$defs": {
    "runningAgent": {
      "title": "AgentsStatusEntry",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "identifier": {
          "type": "string"
        },
        "issue_id": {
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_pid": {
          "type": [
            "string",
            "null"
          ]
        },
        "codex_app_server_pid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "adopted_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_preload": {
          "description": "Skills preloaded for this worker's session; null when the preload is unknown (for example an adopted session).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/skillPreload"
            }
          ]
        }
      },
      "required": [
        "identifier",
        "issue_id",
        "session_id",
        "provider_pid",
        "adopted_from"
      ]
    },
    "skillPreload": {
      "title": "AgentsSkillPreload",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mapped": {
          "description": "Mapped skills inlined into the prompt, with the reason each was mapped.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "reason"
            ]
          }
        },
        "over_budget": {
          "description": "Whether the inlined mapped skills exceed max_bytes. Mapped skills are never truncated, so an over-budget set is still inlined whole.",
          "type": "boolean"
        },
        "missing": {
          "description": "Mapped skills that are not installed in the workspace.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bytes": {
          "description": "Bytes of skill text inlined into the prompt.",
          "type": "integer",
          "minimum": 0
        },
        "max_bytes": {
          "description": "The agent.skills.preload_max_bytes budget in bytes.",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "mapped",
        "over_budget",
        "missing",
        "bytes",
        "max_bytes"
      ]
    }
  }
}
