{
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "error": {
      "const": "capability_unavailable"
    },
    "capability": {
      "type": "string"
    },
    "state": {
      "enum": [
        "degraded",
        "unavailable",
        "unknown"
      ]
    },
    "reason": {
      "$ref": "capabilities.v1.schema.json#/$defs/reason"
    },
    "depends_on": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "boot_id": {
      "type": "string"
    }
  },
  "required": [
    "error",
    "capability",
    "state",
    "reason",
    "revision",
    "boot_id"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiur.team/schemas/capability-error.v1.schema.json",
  "title": "CapabilityError"
}
