{
  "name": "aiur-style",
  "version": "0.0.0",
  "type": "module",
  "description": "Consolidated design system and component library for the Aiur family of sites",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./aiur-style.css": "./dist/aiur-style.css",
    "./css/*": "./dist/css/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "sync": "node scripts/sync.mjs",
    "test": "npm run test:node",
    "test:node": "node --test test/dist.test.mjs",
    "test:visual": "playwright test test/gallery.visual.spec.ts",
    "test:visual:docker": "docker run --rm --ipc=host -v \"$PWD:/work\" -w /work mcr.microsoft.com/playwright:v1.61.1-noble npm run test:visual"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "@playwright/test": "1.61.1",
    "http-server": "14.1.1"
  }
}
