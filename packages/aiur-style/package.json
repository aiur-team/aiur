{
  "name": "aiur-style",
  "version": "0.0.0",
  "type": "module",
  "description": "Consolidated design system and component library for the Aiur family of sites",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./aiur-style.css": "./dist/aiur-style.css",
    "./css/*": "./dist/css/*",
    "./package.json": "./package.json",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme-init.js": "./dist/init/theme-init.js",
    "./vitepress.css": "./dist/vitepress.css",
    "./banner": {
      "types": "./dist/js/banner.d.ts",
      "default": "./dist/js/banner.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "node scripts/build.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "sync": "node scripts/sync.mjs",
    "test": "npm run test:node && npm run test:unit",
    "test:node": "node --test test/*.test.mjs",
    "test:visual": "playwright test",
    "test:visual:docker": "docker run --rm --ipc=host -v \"$PWD:/work\" -w /work mcr.microsoft.com/playwright:v1.61.1-noble npm run test:visual",
    "test:unit": "vitest run test/theme.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "@playwright/test": "1.61.1",
    "http-server": "14.1.1",
    "jsdom": "24.1.3",
    "terser": "5.44.0",
    "vitest": "2.1.9",
    "vitepress": "1.6.4"
  }
}
