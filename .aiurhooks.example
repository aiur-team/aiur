# === aiur workspace hooks (warm-base example) ===
# Referenced from .aiurconfig via `hooks_file: .aiurhooks`. These are the same
# hook keys you can inline under `hooks:` in .aiurconfig — moved to their own
# file so multi-line scripts stay out of the main config and your coding agent
# can regenerate them independently. Run `aiur init` for a prompt you can paste
# to your agent to author a version tuned to your repo's toolchain.
#
# Env available to these hooks:
#   $THIS_REPOSITORY_URL  the repo aiur is working on (for a cold git clone)
#   $AIUR_REPO_BASE       a warm checkout of main (deps installed, build
#                         compiled) to spin a workspace off. Set only when a
#                         `base_setup` hook is configured and dispatch is local;
#                         empty/missing on remote workers or the first run, so
#                         always guard for it.
#
# This example is tuned for the aiur repo (Elixir / mix). Adapt `base_setup`
# and the incremental build step for your toolchain (pnpm, cargo, go, …).

# Run by aiur IN the warm base (~/.aiur/repo/<owner>/<name>) on first build and
# after every main advance, to install deps + compile so workspaces start warm.
base_setup: |
  mix deps.get
  mix compile

# Spin a per-issue workspace off the warm base when present; otherwise fall back
# to a cold clone so dispatch always works. Keep this branch defensive.
after_create: |
  if [ -n "$AIUR_REPO_BASE" ] && [ -d "$AIUR_REPO_BASE/.git" ]; then
    cp -a "$AIUR_REPO_BASE/." .
    git checkout -b "aiur/$(basename "$PWD")" origin/main
    mix compile          # incremental: _build was copied warm from the base
  else
    git clone "$THIS_REPOSITORY_URL" .
    git checkout -b "aiur/$(basename "$PWD")" origin/main
  fi

before_run: |
  if [ ! -d .git ] || ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    find . -mindepth 1 -maxdepth 1 -exec rm -rf {} +
    git clone "$THIS_REPOSITORY_URL" .
    git checkout -b "aiur/$(basename "$PWD")" origin/main
  fi
