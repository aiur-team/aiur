.compound-engineering/*.local.yaml
.git-writable/
AGENTS.local.md
.env
.env.local
.env.*.local
.env.swp
.agent-label-snapshot.json
.agent-label-restore.sh
src/WORKFLOW.md

# Per-machine scratch folder agents create while exercising opencode/codex.
# Created by ad hoc smoke tests, not tracked.
test-sandbox/

# Local runtime artifacts
.claude/scheduled_tasks.lock
.context/
.aiur-agent-ir/
.aiur-runtime/
logs/
erl_crash.dump

# Per-workspace package-manager caches populated by Aiur prewarm hooks.
/.aiur-hex/
/.aiur-mix/

# Per-run test3 timing log (regenerated by scripts/aiur-test3-timer; see #384).
# NB: do NOT ignore the broad `.aiur-test*.json` glob — `.aiur-test-tickets.json`
# is an intentionally-committed pinned-config file read by Aiur.TestReset.
.aiur-test3-runs.jsonl

# Stale pre-`src/`-layout build cruft (see #282/#384). The real build is under src/.
/elixir/

# Local Netlify folder
.netlify

# Stream Deck package build and dependency artifacts.
packages/streamdeck/node_modules/
packages/streamdeck/coverage/
packages/streamdeck/dist/
/packages/streamdeck/**/*.streamDeckPlugin
.aiur-design-import/

# Python bytecode (analytics/ tooling)
__pycache__/
*.pyc

.aiur-base-built

# Machine-local toolchain caches created by the pre-warmed mise/hex setup
# (elixir_make NIFs, mise tracked-config state). Regenerated on demand.
/.cache/
/.local/

# Home-directory noise created when a workspace runs with HOME set to the repo
# root: npm debug logs and its update-notifier stamp, Chromium crash reports
# from the VitePress/Playwright docs build, and Playwright's run marker. All of
# these were committed by a docs branch (#1505) before being ignored here.
/.npm/
/.config/
/website/test-results/

# Runtime build-gate lock namespace created by agent-launched Mix verification.
.aiur/build-gate.locks/

# Provider model catalogue cache (Aiur.ModelDiscovery). Refetched on a 24h TTL;
# a cold start falls back to the curated registry list, so it is never a
# dependency worth committing.
.aiur/model-catalog.json
.aiur/update-check.json
