{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "report.v1",
  "type": "object",
  "properties": {
    "schema_version": {"const": "report.v1"},
    "header": {"type": "object", "properties": {"experiment_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "report_version": {"type": "integer", "minimum": 1}, "analysis_type": {"enum": ["interim", "confirmatory"]}, "generated_at": {"type": "string", "format": "date-time"}, "analyst": {"type": "object", "properties": {"role": {"type": "string", "minLength": 1}, "agent": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "ticket": {"type": ["integer", "string"]}}, "required": ["role", "agent", "model", "ticket"]}, "stats_snapshot_hash": {"type": "string", "minLength": 1}, "events_snapshot_hash": {"type": "string", "minLength": 1}, "preregistration_hash": {"type": "string", "minLength": 1}}, "required": ["experiment_id", "title", "analysis_type", "generated_at", "analyst", "stats_snapshot_hash", "events_snapshot_hash", "preregistration_hash"]},
    "summary": {"type": "string", "minLength": 1},
    "preregistration": {"type": "object", "properties": {"record": {"type": "object", "properties": {"schema_version": {"const": "preregistration.v1"}, "experiment_id": {"type": "string", "minLength": 1}, "registered_at": {"type": "string", "format": "date-time"}, "registered_by": {"type": "object", "properties": {"role": {"type": "string", "minLength": 1}, "agent": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "ticket": {"type": ["integer", "string"]}}, "required": ["role", "agent", "model", "ticket"]}, "hypothesis": {"type": "string", "minLength": 1}, "primary_metrics": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "expected": {"enum": ["decrease", "increase", "no-change", "no-increase", "no-decrease"]}}, "required": ["id", "expected"]}, "minItems": 1}, "secondary_metrics": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "expected": {"enum": ["decrease", "increase", "no-change", "no-increase", "no-decrease"]}}, "required": ["id", "expected"]}}, "guardrail_metrics": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "expected": {"enum": ["decrease", "increase", "no-change", "no-increase", "no-decrease"]}}, "required": ["id", "expected"]}}, "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "secondary_correction": {"enum": ["benjamini-hochberg"]}, "fdr_q": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "mde": {"type": "object", "properties": {"metric": {"type": "string", "minLength": 1}, "relative": {"type": "number"}}, "required": ["metric", "relative"]}, "power_target": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "planned_n_per_cohort": {"type": "integer", "minimum": 1}, "projected_ready_at": {"type": "string", "minLength": 1}, "stratify_by": {"type": "array", "items": {"type": "string", "minLength": 1}}, "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}}, "stopping_rule": {"type": "string", "minLength": 1}, "baseline_snapshot_hash": {"type": "string", "minLength": 1}, "post_hoc": {"type": "boolean"}, "amendments": {"type": "array", "items": {"type": "object"}}}, "required": ["schema_version", "experiment_id", "registered_at", "registered_by", "hypothesis", "primary_metrics", "secondary_metrics", "guardrail_metrics", "alpha", "secondary_correction", "fdr_q", "mde", "power_target", "planned_n_per_cohort", "projected_ready_at", "stratify_by", "exclusions", "stopping_rule", "baseline_snapshot_hash"]}, "deviations": {"type": "array", "items": {"type": "object", "properties": {"what": {"type": "string", "minLength": 1}, "why": {"type": "string", "minLength": 1}}, "required": ["what", "why"]}}}, "required": ["record", "deviations"]},
    "design": {"type": "object", "properties": {"kind": {"enum": ["line", "cohorts"]}, "windows": {"type": "object"}, "cohorts": {"type": "array"}, "unit_of_analysis": {"type": "string", "minLength": 1}, "inclusions": {"type": "object"}, "exclusions": {"type": "object"}, "strata": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "required": ["kind", "windows", "cohorts", "unit_of_analysis", "inclusions", "exclusions", "strata"]},
    "sample": {"type": "object", "properties": {"cohorts": {"type": "array", "items": {"type": "object", "properties": {"cohort": {"type": "string", "minLength": 1}, "stratum": {"type": "string", "minLength": 1}, "n": {"type": "integer", "minimum": 0}, "excluded": {"type": "object"}}, "required": ["cohort", "stratum", "n", "excluded"]}}, "balance": {"type": ["object", "string"]}, "srm_p": {"type": ["number", "null"]}}, "required": ["cohorts", "balance", "srm_p"]},
    "results": {"type": "array", "items": {"type": "object", "properties": {"metric": {"type": "string", "minLength": 1}, "role": {"enum": ["primary", "secondary", "guardrail", "exploratory"]}, "unit": {"type": "string", "minLength": 1}, "n": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "integer", "minimum": 0}}, "median": {"type": "object", "minProperties": 2, "additionalProperties": {"type": ["number", "null"]}}, "iqr": {"type": "object", "minProperties": 2, "additionalProperties": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}, "effect": {"type": "object", "properties": {"kind": {"enum": ["median_difference", "median_ratio", "rate_ratio", "difference", "ratio", "proportion_difference"]}, "value": {"type": ["number", "null"]}}, "required": ["kind", "value"]}, "ci95": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "p": {"type": ["number", "null"]}, "p_adjusted": {"type": ["number", "null"]}, "family": {"type": "string", "minLength": 1}, "power_at_mde": {"type": ["number", "null"]}, "mde_at_n": {"type": ["number", "null"]}, "n_needed_per_cohort": {"type": ["integer", "null"], "minimum": 1}, "engine_label": {"enum": ["not-enough-data", "underpowered", "inconclusive", "no-effect-detected", "significant"]}, "label": {"enum": ["not-enough-data", "underpowered", "inconclusive", "no-effect-detected", "significant"]}, "label_reason": {"type": "string"}, "modifiers": {"type": "array", "items": {"enum": ["confounded"]}, "uniqueItems": true}, "direction": {"enum": ["as-expected", "opposite", "none"]}}, "required": ["metric", "role", "unit", "n", "median", "iqr", "effect", "ci95", "p", "p_adjusted", "family", "power_at_mde", "mde_at_n", "n_needed_per_cohort", "engine_label", "label", "label_reason", "modifiers", "direction"]}, "minItems": 1},
    "confounders": {"type": "array", "items": {"type": "object", "properties": {"event_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "at": {"type": ["string", "array"], "minLength": 1, "items": {"type": "string", "minLength": 1}, "minItems": 2, "maxItems": 2}, "ref": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "classification": {"enum": ["treatment", "bug-fix", "unrelated-change", "config", "release", "incident", "outage", "main-red", "capacity"]}, "affects": {"type": "array", "items": {"type": "string", "minLength": 1}}, "bias": {"enum": ["inflates", "deflates", "unknown"]}, "severity": {"enum": ["none", "low", "high"]}, "handling": {"enum": ["excluded", "sensitivity", "noted"]}, "note": {"type": "string", "minLength": 1}, "sensitivity_id": {"type": "string", "minLength": 1}}, "required": ["event_id", "kind", "at", "ref", "title", "classification", "affects", "bias", "severity", "handling", "note"]}},
    "sensitivity": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "what": {"type": "string", "minLength": 1}, "results": {"type": "array", "items": {"type": "object", "properties": {"metric": {"type": "string", "minLength": 1}, "role": {"enum": ["primary", "secondary", "guardrail", "exploratory"]}, "unit": {"type": "string", "minLength": 1}, "n": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "integer", "minimum": 0}}, "median": {"type": "object", "minProperties": 2, "additionalProperties": {"type": ["number", "null"]}}, "iqr": {"type": "object", "minProperties": 2, "additionalProperties": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}, "effect": {"type": "object", "properties": {"kind": {"enum": ["median_difference", "median_ratio", "rate_ratio", "difference", "ratio", "proportion_difference"]}, "value": {"type": ["number", "null"]}}, "required": ["kind", "value"]}, "ci95": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "p": {"type": ["number", "null"]}, "p_adjusted": {"type": ["number", "null"]}, "family": {"type": "string", "minLength": 1}, "power_at_mde": {"type": ["number", "null"]}, "mde_at_n": {"type": ["number", "null"]}, "n_needed_per_cohort": {"type": ["integer", "null"], "minimum": 1}, "engine_label": {"enum": ["not-enough-data", "underpowered", "inconclusive", "no-effect-detected", "significant"]}, "label": {"enum": ["not-enough-data", "underpowered", "inconclusive", "no-effect-detected", "significant"]}, "label_reason": {"type": "string"}, "modifiers": {"type": "array", "items": {"enum": ["confounded"]}, "uniqueItems": true}, "direction": {"enum": ["as-expected", "opposite", "none"]}}, "required": ["metric", "role", "unit", "n", "median", "iqr", "effect", "ci95", "p", "p_adjusted", "family", "power_at_mde", "mde_at_n", "n_needed_per_cohort", "engine_label", "label", "label_reason", "modifiers", "direction"]}}, "conclusion_holds": {"type": "boolean"}}, "required": ["id", "what", "results", "conclusion_holds"]}},
    "threats": {"type": "object", "properties": {"internal": {"type": "array", "items": {"type": "string", "minLength": 1}}, "construct": {"type": "array", "items": {"type": "string", "minLength": 1}}, "external": {"type": "array", "items": {"type": "string", "minLength": 1}}, "statistical_conclusion": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "required": ["internal", "construct", "external", "statistical_conclusion"]},
    "labels": {"type": "array", "items": {"enum": ["not-enough-data", "underpowered", "inconclusive", "no-effect-detected", "significant", "confounded"]}, "uniqueItems": true, "minItems": 1},
    "recommendation": {"type": "object", "properties": {"action": {"enum": ["keep", "revert", "extend-window", "rerun-stratified", "redesign"]}, "why": {"type": "string", "minLength": 1}, "condition": {"type": "string", "minLength": 1}, "next_analysis": {"type": "object", "properties": {"kind": {"enum": ["at_n", "on", "none"]}, "value": {"type": ["integer", "string", "null"]}}, "required": ["kind", "value"]}}, "required": ["action", "why", "condition", "next_analysis"]},
    "reproduce": {"type": "object", "properties": {"commands": {"type": "array", "items": {"type": "string", "minLength": 1}}, "snapshot_hashes": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}, "analyst_computed": {"type": "array", "items": {"type": "object", "properties": {"description": {"type": "string", "minLength": 1}, "script": {"type": "string", "minLength": 1}}, "required": ["description", "script"]}}}, "required": ["commands", "snapshot_hashes", "analyst_computed"]}
  },
  "required": ["schema_version", "header", "summary", "preregistration", "design", "sample", "results", "confounders", "sensitivity", "threats", "labels", "recommendation", "reproduce"]
}
