{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Consumer metric pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "unit",
          "unit_of_analysis",
          "group",
          "kind",
          "better",
          "default_direction",
          "requires",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "unit_of_analysis": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "duration",
              "count",
              "binary",
              "rate",
              "bucketed"
            ]
          },
          "better": {
            "enum": [
              "lower",
              "higher"
            ]
          },
          "default_direction": {
            "enum": [
              "increase",
              "decrease",
              "none"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start",
                  "end",
                  "unit_key"
                ],
                "properties": {
                  "kind": {
                    "const": "event_interval"
                  },
                  "start": {
                    "type": "string",
                    "pattern": "^(?:[a-zA-Z0-9_-]+|\\*|#)(?:\\.(?:[a-zA-Z0-9_-]+|\\*|#))*$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^(?:[a-zA-Z0-9_-]+|\\*|#)(?:\\.(?:[a-zA-Z0-9_-]+|\\*|#))*$"
                  },
                  "unit_key": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^/(?:[^~]|~[01])*$"
                      },
                      {
                        "type": "string",
                        "pattern": "^topic:[0-9]+$"
                      }
                    ]
                  },
                  "attrs": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^/(?:[^~]|~[01])*$"
                    },
                    "propertyNames": {
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "match"
                ],
                "properties": {
                  "kind": {
                    "const": "event_count"
                  },
                  "match": {
                    "type": "string",
                    "pattern": "^(?:[a-zA-Z0-9_-]+|\\*|#)(?:\\.(?:[a-zA-Z0-9_-]+|\\*|#))*$"
                  },
                  "unit_key": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^/(?:[^~]|~[01])*$"
                      },
                      {
                        "type": "string",
                        "pattern": "^topic:[0-9]+$"
                      }
                    ]
                  },
                  "per": {
                    "enum": [
                      "hour",
                      "day"
                    ]
                  },
                  "attrs": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^/(?:[^~]|~[01])*$"
                    },
                    "propertyNames": {
                      "minLength": 1
                    }
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "unit_key"
                    ],
                    "not": {
                      "required": [
                        "per"
                      ]
                    }
                  },
                  {
                    "required": [
                      "per"
                    ],
                    "not": {
                      "required": [
                        "unit_key"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "const": "ndjson"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?:state:)?(?!/)(?!.*(?:^|/|:)\\.\\.(?:/|$))[^\\u0000]+$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "argv",
                  "cwd"
                ],
                "properties": {
                  "kind": {
                    "const": "script"
                  },
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "cwd": {
                    "const": "repo"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$id": "https://aiur.team/schemas/experiments/pack.v1.schema.json"
}
