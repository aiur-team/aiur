tracker:
  kind: linear
  base_branch: your-base-branch
  active_states:
    - Todo
    - In Progress
  terminal_states:
    - Closed
    - Cancelled
    - Canceled
    - Duplicate
    - Done
linear:
  api_key: $LINEAR_API_KEY
  project_slug: your-project-slug
observability:
  # Set to false to disable run telemetry recording (Analytics page will be empty).
  # telemetry_enabled: true
  # Retain useful cross-session telemetry without splitting an individual boot.
  telemetry_retention_max_bytes: 67108864
  telemetry_retention_max_age_days: 30
workspace:
  root: ~/code/aiur-workspaces
hooks:
  after_create: |
    # Aiur runs this in an empty atomic staging directory.
    git clone "$THIS_REPOSITORY_URL" .
  before_remove: |
    git status --short
agent:
  priority: [codex]
  max_concurrent_agents: 10
  max_turns: 20
  # max_turns_by_complexity: {1: 6, 2: 12, 3: 20}
  # OpenRouter is an aggregator with its own sub-routing tier (#1923): list it
  # in `priority` as a tier and configure its `provider` object (order /
  # allow_fallbacks / ignore / sort) so the upstream is chosen predictably.
  # First-party backends such as DeepSeek stay directly configurable as peers:
  # priority: [openrouter, codex]
  # backend_configs:
  #   openrouter:
  #     model: router/auto
  #     provider:
  #       order: [DeepSeek]
  #       allow_fallbacks: true
  #       sort: price
codex:
  command: codex app-server
prompt_file: linear-codex.prompt.md
