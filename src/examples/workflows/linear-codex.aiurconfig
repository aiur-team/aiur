tracker:
  kind: linear
  active_states:
    - Todo
    - In Progress
  terminal_states:
    - Closed
    - Cancelled
    - Canceled
    - Duplicate
    - Done
linear:
  api_key: $LINEAR_API_KEY
  project_slug: your-project-slug
workspace:
  root: ~/code/aiur-workspaces
hooks:
  after_create: |
    git clone "$THIS_REPOSITORY_URL" .
  before_remove: |
    git status --short
agent:
  kind: codex
  max_concurrent_agents: 10
  max_turns: 20
codex:
  command: codex app-server
prompt_file: linear-codex.prompt.md
