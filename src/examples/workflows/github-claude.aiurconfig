tracker:
  kind: github
  active_states:
    - todo
    - in-progress
  terminal_states:
    - done
    - closed
github:
  repo: your-org/your-repo
  label_prefix: agent
  # Optional: trusted human operator logins whose GitHub comments reach
  # agent event digests even when CODEOWNERS team expansion is unavailable.
  # trusted_accounts:
  #   - your-github-login
workspace:
  root: ~/code/aiur-workspaces
hooks:
  after_create: |
    git clone "$THIS_REPOSITORY_URL" .
agent:
  kind: claude
  max_concurrent_agents: 5
  max_turns: 20
claude:
  command: aiur-claude
prompt_file: github-claude.prompt.md
