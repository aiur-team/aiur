tracker:
  kind: github
  base_branch: your-base-branch
  active_states:
    - todo
    - in-progress
    - human-review
    - rework
    - merging
  terminal_states:
    - done
    - closed
    - cancelled
    - canceled
  github:
    repo: your-org/your-repo
    label_prefix: agent
    # Required for server-side dispatch authorization. When omitted, Aiur uses
    # the currently resolved CODEOWNERS set and denies dispatch if unavailable.
    allowed_users:
      - your-github-login
      - your-teammate-login
    # Required for human-only merge attribution. Keep machine identities out.
    human_mergers:
      - your-github-login
    # Optional: trusted human Executor logins whose GitHub comments reach
    # agent event digests even when CODEOWNERS team expansion is unavailable.
    # trusted_accounts:
    #   - your-github-login
    # Build Order planning graph safeguards; each must be a finite positive integer.
    # Defaults accept exactly 100 roots/direct members across at most four pages/calls.
    planning_root_limit: 100
    planning_page_budget: 4
    planning_call_budget: 4
    # Host-local coordination for daemons and agent `gh` calls sharing one token.
    max_inflight: 4
    max_inflight_per_endpoint: 2
    requests_per_minute: 120
    stagger_ms: 75
build_order:
  # Supervised configured-repository detail and sanitized typed-history providers.
  # Restart clears retained snapshots; selected tickets reload on demand.
  ticket_detail_freshness_ms: 30000
  graph_catalog_refresh_ms: 60000
  graph_selected_refresh_ms: 15000
  graph_demand_refresh_ms: 5000
  graph_refresh_timeout_ms: 30000
  graph_max_selected_roots: 32
  graph_max_inflight: 4
  ticket_detail_max_entries: 32
  ticket_detail_max_description_bytes: 16384
  ticket_history_limit: 50
  ticket_history_max_identities: 100
  ticket_history_stale_after_ms: 60000
observability:
  # Set to false to disable run telemetry recording (Analytics page will be empty).
  # telemetry_enabled: true
  # Retain useful cross-session telemetry without splitting an individual boot.
  telemetry_retention_max_bytes: 67108864
  telemetry_retention_max_age_days: 30
polling:
  interval_seconds: 30
server:
  host: 127.0.0.1
  port: 4000
workspace:
  root: ~/code/aiur-workspaces
hooks:
  after_create: |
    # Aiur runs this in an empty atomic staging directory.
    git clone "$THIS_REPOSITORY_URL" .
    issue_id="$(basename "$PWD")"
    git checkout -b "aiur/${issue_id}" "origin/$THIS_BASE_BRANCH"
    git update-ref refs/aiur/branch-start HEAD
  before_remove: |
    git status --short
agent:
  kind: codex
  max_concurrent_agents: 2
  max_turns: 12
  # Cold backend switches continue from workspace context; provider transcripts
  # are never transferred across backends.
  prior_work_continuation: true
  # Direct OpenAI-compatible instances use keys from the environment (prefer
  # ~/.aiur/.env) and can be enabled/selected without adding provider unions:
  # backend_configs:
  #   deepseek: {enabled: false}
  #   openrouter: {model: moonshotai/kimi-k2.7-code}
  # max_turns_by_complexity: {1: 4, 2: 8, 3: 12}
  # Optional: route per issue by its `complexity:N` label. Unlisted levels and
  # unlabeled issues fall back to `kind`; a `model:<backend>` issue label
  # overrides both. (Requires a `claude:` block for the routed backend.)
  # routing:
  #   1: codex:gpt-5.6-luna:low
  #   2: codex:gpt-5.6-luna:medium
  #   3: codex:gpt-5.6-terra:high
  #   4: codex:gpt-5.6-terra:xhigh
  #   5: codex:gpt-5.6-sol:max
codex:
  command: codex app-server
prompt_file: github-codex.prompt.md
