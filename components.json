      ],
      "reason": "#3777: merge tracker task resolves missing GitHub merger attribution through the governed transport"
    },
    {
      "from": "orchestration",
      "to_module": "Aiur.BuildQueue",
      "kind": "reference",
      "only_paths": [
        "src/lib/aiur/orchestrator/blocker_propagation.ex"
      ],
      "reason": "#3820: read optional queue membership and effective optimistic triggers; absent queues disable the default"
    },
    {
      "from": "orchestration",
      "to_module": "Aiur.BuildQueue.Hints",
      "kind": "reference",
      "reason": "MP-E1 X-1: neutral rank and hold reads in DispatchPolicy"
    },
    {
      "from": "orchestration",
      "to_module": "Aiur.BuildQueue.ClaimProbe",
      "kind": "behaviour",
      "reason": "MP-E1 X-1: orchestration implements the claim-probe port"
    },
