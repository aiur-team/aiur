      "to_module": "Aiur.GitHub.IssueState",
      "kind": "reference",
      "only_paths": [
        "src/lib/aiur/orchestrator/merge_transition.ex"
      ],
      "reason": "#3778: merge outcome classification reuses GitHub closed-state and marker-label policy"
    },
