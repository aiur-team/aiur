        "src/lib/aiur/orchestrator/blocker_propagation.ex",
        "src/lib/aiur/orchestrator/merge_order_audit.ex",
        "src/lib/aiur/orchestrator/restack_scheduler.ex"
      ],
      "reason": "#3771: GitHub-only restack scheduling consumes locally held direct blocker evidence"
