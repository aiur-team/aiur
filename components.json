    {
      "from": "harness-adapters",
      "to_module": "Aiur.Accounts.*",
      "kind": "reference",
      "only_paths": [
        "src/lib/aiur/coding_agent/headroom_dispatch.ex"
      ],
      "reason": "#3960: headroom dispatch ranks candidates with the pure Accounts.Headroom selector over polled UsageReadings"
    },
