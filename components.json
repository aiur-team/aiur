  "features": [
    {"id": "MP-E1", "name": "Build queue", "summary": "Order tickets and hold them until their prerequisites are ready.", "extends": ["build-orders", "build-queue", "orchestration", "tracker"], "adds": [], "public": false, "shipped_in": null},
    {"id": "MP-E2", "name": "Native question capture", "summary": "Turn native agent questions into Commands that reach the right responder.", "extends": ["commands", "executor-attention", "harness-adapters"], "adds": [], "public": false, "shipped_in": null},
    {"id": "MP-E3", "name": "Executor communication", "summary": "Read the Executor conversation and send it messages from operator surfaces.", "extends": ["conversations", "executor-attention", "harness-adapters"], "adds": [], "public": false, "shipped_in": null},
    {"id": "MP-E4", "name": "Dashboard conversations", "summary": "Read full agent conversations and jump from events to their context.", "extends": ["commands", "conversations", "dashboard-ui"], "adds": [], "public": false, "shipped_in": null},
    {"id": "MP-E5", "name": "Dashboard voice input", "summary": "Dictate messages and Command responses in worker and Executor views.", "extends": ["commands", "dashboard-ui", "voice-stt"], "adds": [], "public": false, "shipped_in": null},
    {"id": "MP-E6", "name": "Conversational voice", "summary": "Talk with a worker agent or the Executor using a shared voice assistant.", "extends": ["commands", "conversations", "voice-stt"], "adds": ["voice-conversation"], "public": false, "shipped_in": null},
    {"id": "MP-E7", "name": "Agent listener modes", "summary": "Choose steer, synchronous or asynchronous message delivery for each agent.", "extends": ["harness-adapters", "orchestration"], "adds": ["listener-modes", "listener-spec"], "public": false, "shipped_in": null},
    {"id": "MP-N1", "name": "Mobile app architecture", "summary": "Use a shared phone app to access Aiur on iOS and Android.", "extends": ["aiur-contracts", "web-shell"], "adds": ["mobile-app"], "public": false, "shipped_in": null},
    {"id": "MP-N2", "name": "Pairing and discovery", "summary": "Pair a phone with a machine and discover its instances with revocable access.", "extends": ["identity", "launcher", "web-shell"], "adds": ["machine-gateway", "pairing-discovery"], "public": false, "shipped_in": null},
    {"id": "MP-N3", "name": "Instance overview", "summary": "See instance status and pending Commands before opening an instance dashboard.", "extends": ["build-orders", "executor-attention", "mobile-app", "projections"], "adds": [], "public": false, "shipped_in": null},
    {"id": "MP-N4", "name": "Encrypted notifications", "summary": "Receive encrypted event notifications that only paired devices can read.", "extends": ["commands", "event-bus", "identity", "pairing-discovery"], "adds": ["push-relay", "relay-service"], "public": false, "shipped_in": null},
    {"id": "MP-N5", "name": "Notification preferences", "summary": "Choose which events notify each device and suppress duplicate notifications.", "extends": ["build-orders", "commands", "push-relay"], "adds": ["notification-policy"], "public": false, "shipped_in": null},
