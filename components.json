      "from": "orchestration",
      "to_module": "Aiur.BuildQueue.ClaimProbe",
      "kind": "reference",
      "only_paths": [
        "src/lib/aiur/orchestrator/build_queue_claim_probe.ex"
      ],
      "reason": "MP-E1 X-1: typed callback implementation references ClaimProbe result types"
    },
    {
      "from": "pr-lifecycle",
      "to_module": "Aiur.Orchestrator.TicketTransition",
      "kind": "reference",
      "only_paths": [
        "src/lib/aiur/pr_lifecycle/rework_requeue.ex"
      ],
      "allow_forbidden": true,
      "reason": "MP-R1-C9-T06 RC-20: U2 keeps requeue decisions in the worker and routes writes through its single lifecycle owner (#3570)"
    },
    {
      "from": "build-queue",
      "to_module": "Aiur.Orchestrator.TicketTransition",
      "kind": "reference",
      "only_paths": [
        "src/lib/aiur/build_queue/write_protocol.ex"
      ],
