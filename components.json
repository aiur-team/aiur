    {
      "from": "orchestration",
      "to_module": "Aiur.Stacking.MergeOrder",
      "kind": "reference",
      "only_paths": [
        "src/lib/aiur/orchestrator/merge_order_audit.ex"
      ],
      "reason": "#3772: merge-order audit reuses the pure blocker-containment verdict"
    },
    {
      "from": "github",
      "to_module": "Aiur.BuildOrder.History",
      "kind": "reference",
      "only_paths": [
        "src/lib/aiur/github/tracker.ex"
      ],
      "allow_forbidden": true,
